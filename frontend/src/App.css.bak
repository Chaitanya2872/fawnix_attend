@import url("https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap");

:root {
  color-scheme: light;
  font-family:
    "Manrope",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    sans-serif;
  line-height: 1.5;
  font-weight: 400;
  background: #f7f4ef;
  color: #1f2a2e;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

button,
input,
select,
textarea {
  font-family: inherit;
}

body {
  margin: 0;
  background: #f7f4ef;
}

a {
  color: inherit;
  text-decoration: none;
}

#root {
  min-height: 100vh;
}

.page {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.policy-page {
  min-height: 100vh;
  background: #f5f1e8;
}

.policy-hero {
  padding: 48px 8vw 24px;
}

.policy-hero-inner {
  max-width: 860px;
}

.policy-back {
  display: inline-flex;
  margin-bottom: 20px;
  padding: 8px 14px;
  border-radius: 999px;
  background: rgba(17, 44, 50, 0.08);
  color: #112c32;
  font-size: 13px;
  font-weight: 600;
}

.policy-hero h1 {
  margin: 12px 0;
  font-size: clamp(34px, 4vw, 58px);
  color: #112c32;
}

.policy-lead {
  max-width: 760px;
  font-size: 18px;
  color: #405156;
}

.policy-content {
  padding: 12px 8vw 72px;
  display: grid;
  gap: 18px;
}

.policy-card {
  max-width: 900px;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 16px 34px rgba(17, 44, 50, 0.08);
  backdrop-filter: blur(8px);
}

.policy-card h2 {
  margin: 0 0 12px;
  color: #112c32;
  font-size: 24px;
}

.policy-card p {
  margin: 0 0 12px;
  color: #46575c;
}

.policy-card p:last-child {
  margin-bottom: 0;
}

.policy-list {
  margin: 0;
  padding-left: 20px;
  color: #46575c;
}

.policy-list li {
  margin-bottom: 8px;
}

.policy-list li:last-child {
  margin-bottom: 0;
}

.admin-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 266px minmax(0, 1fr);
  background: #f4f6fb;
}

.admin-shell-login {
  grid-template-columns: minmax(0, 1fr);
  background:
    radial-gradient(
      circle at top left,
      rgba(31, 167, 164, 0.08),
      transparent 28%
    ),
    linear-gradient(180deg, #f8f4ec, #efe7d9);
}

.sidebar {
  background: linear-gradient(180deg, #35544a 0%, #29443c 100%);
  color: rgba(255, 255, 255, 0.82);
  padding: 12px 06px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  border-right: 1px solid rgba(20, 40, 67, 0.08);
  min-height: 100vh;
  position: sticky;
  top: 0;
  overflow-y: auto;
  font-family:
    "Manrope",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    sans-serif;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 0 8px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.sidebar-logo {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: linear-gradient(135deg, #d79a55 0%, #b86f36 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 600;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 4px 14px rgba(184, 111, 54, 0.35);
}

.sidebar-brand-text {
  display: flex;
  align-items: center;
  gap: 8px;
}

.brand-admin-badge {
  padding: 2px 7px;
  border-radius: 4px;
  background: rgba(222, 166, 98, 0.2);
  color: #f2c58e;
  font-size: 9px;
  font-weight: 500;
}

.brand-mark-image {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  object-fit: cover;
  box-shadow: 0 10px 24px rgba(4, 14, 16, 0.28);
  background: rgba(255, 255, 255, 0.12);
}

.sidebar-group {
  display: grid;
  gap: 8px;
  align-content: start;
  flex: 1 1 auto;
  overflow-y: auto;
  padding-right: 3px;
}

.sidebar-group::-webkit-scrollbar {
  width: 6px;
}

.sidebar-group::-webkit-scrollbar-thumb {
  background: rgba(220, 239, 233, 0.18);
  border-radius: 999px;
}

.sidebar-logout {
  position: sticky;
  bottom: 16px;
  margin-top: auto;
  display: grid;
  gap: 10px;
  padding-top: 8px;
  background: transparent;
  z-index: 1;
}

.sidebar-link {
  width: 100%;
  text-align: left;
  border: none;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.045);
  color: rgba(255, 255, 255, 0.76);
  padding: 14px 16px;
  font-size: 14px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    background 0.2s ease;
}

.sidebar-link-main {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.sidebar-link-icon {
  width: 28px;
  height: 28px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.08);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sidebar-link-icon svg {
  width: 16px;
  height: 16px;
}

.sidebar-link-label {
  min-width: 0;
}

.sidebar-link-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36px;
  padding: 3px 7px;
  border-radius: 6px;
  background: rgba(31, 167, 164, 0.18);
  color: #a8f0e2;
  font-size: 10px;
  font-weight: 500;
  flex-shrink: 0;
}

.sidebar-link:hover {
  transform: translateX(3px);
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.95);
}

.sidebar-link.active {
  background: rgba(213, 149, 78, 0.34);
  color: #fff;
}

.sidebar-link.active .sidebar-link-icon {
  background: rgba(213, 149, 78, 0.3);
}

.sidebar-link.active .sidebar-link-badge {
  background: rgba(213, 149, 78, 0.24);
  color: #f2c58e;
}

.sidebar-link.logout-link {
  background: #f6c17a;
  color: #2b160b;
  border: none;
  font-weight: 600;
}

.sidebar-foot {
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.sidebar-profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 2px 4px;
  min-width: 0;
}

.sidebar-avatar {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: linear-gradient(135deg, #d79a55 0%, #b86f36 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 3px 10px rgba(184, 111, 54, 0.3);
}

.sidebar-profile-info {
  min-width: 0;
  flex: 1;
}

.sidebar-profile-info strong {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-profile-info span {
  display: block;
  font-size: 11px;
  color: rgba(255, 255, 255, 0.5);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-foot-actions {
  display: flex;
  gap: 6px;
}

.sidebar-foot-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 7px 10px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.6);
  font-size: 11px;
  font-weight: 500;
  cursor: pointer;
  transition:
    background 0.15s ease,
    color 0.15s ease;
}

.sidebar-foot-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.9);
}

.sidebar-note {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 18px;
  padding: 16px;
}

.sidebar-note strong,
.sidebar-note span {
  display: block;
}

.sidebar-note span {
  margin-top: 6px;
  color: #c3d5d1;
  font-size: 13px;
}

.sidebar-back {
  width: 100%;
  border-color: rgba(255, 255, 255, 0.5);
  color: #eef7f5;
}

.dashboard-main {
  padding: 28px 32px;
  display: grid;
  gap: 22px;
  background: #f4f6fb;
  align-content: start;
}

.dashboard-main-login {
  min-height: 100vh;
  padding: 0;
  align-content: stretch;
}

.dashboard-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.9fr);
  gap: 20px;
  align-items: stretch;
}

.dashboard-hero h1 {
  margin: 12px 0;
  font-size: clamp(30px, 3vw, 48px);
  color: #112c32;
}

.dashboard-copy {
  max-width: 720px;
  color: #4a5b60;
  font-size: 17px;
}

.refresh-toast {
  display: inline-flex;
  margin-top: 14px;
  padding: 8px 14px;
  border-radius: 999px;
  background: #e6f4f3;
  color: #0f4449;
  font-size: 12px;
  font-weight: 600;
  box-shadow: 0 6px 16px rgba(17, 44, 50, 0.08);
}

.dashboard-highlight {
  background: rgba(255, 255, 255, 0.74);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(17, 44, 50, 0.08);
  box-shadow: 0 18px 40px rgba(17, 44, 50, 0.08);
}

.dashboard-hero-side {
  display: grid;
  gap: 14px;
  align-content: start;
}

.dashboard-profile-menu {
  position: relative;
  width: fit-content;
  height: fit-content;
  max-width: 100%;
  justify-self: end;
  align-self: start;
}

.dashboard-user-card {
  width: auto;
  min-width: 245px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 8px 4px;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: #17383e;
  text-align: left;
}

.dashboard-user-card:hover {
  background: rgba(17, 44, 50, 0.05);
}

.dashboard-user-avatar {
  width: 46px;
  height: 46px;
  flex: 0 0 46px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(135deg, #58c6b5, #2d8e8b);
  font-size: 19px;
  font-weight: 600;
}

.dashboard-user-copy {
  min-width: 0;
  flex: 0 1 auto;
  display: grid;
  gap: 3px;
}

.dashboard-user-card span {
  color: #668085;
  font-size: 11px;
  font-weight: 400;
}

.dashboard-user-card strong {
  overflow: hidden;
  font-size: 15px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dashboard-user-card small {
  color: #587076;
  font-size: 12px;
}

.dashboard-user-chevron {
  color: #4f686d !important;
  font-size: 20px !important;
  line-height: 1;
  transition: transform 0.2s ease;
}

.dashboard-user-chevron.open {
  transform: rotate(180deg);
}

.dashboard-profile-dropdown {
  position: absolute;
  z-index: 20;
  top: calc(100% + 8px);
  right: 0;
  width: 160px;
  padding: 7px;
  border: 1px solid rgba(17, 44, 50, 0.1);
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 16px 36px rgba(17, 44, 50, 0.16);
}

.dashboard-profile-dropdown button {
  width: 100%;
  padding: 11px 13px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #b12c3b;
  text-align: left;
  font-weight: 600;
}

.dashboard-profile-dropdown button:hover {
  background: #fff0f1;
}

.dashboard-highlight {
  border-radius: 28px;
  padding: 24px;
  display: grid;
  align-content: center;
}

.dashboard-highlight span {
  color: #52656b;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  font-size: 12px;
  font-weight: 600;
}

.dashboard-highlight strong {
  font-size: 52px;
  color: #112c32;
  margin: 12px 0 6px;
}

.dashboard-highlight p {
  margin: 0;
  color: #45565c;
}

.login-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 22px;
  padding: 18px;
  display: grid;
  gap: 12px;
}

.login-card h3,
.login-card p {
  margin: 0;
}

.login-card p {
  color: #d3e3df;
  font-size: 14px;
}

.login-card label {
  font-size: 13px;
  color: #e6f3f0;
}

.login-card input {
  width: 100%;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.95);
  color: #112c32;
}

.login-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.login-card .ghost {
  color: #fff;
}

.login-stage {
  min-height: 100vh;
  display: grid;
  place-items: stretch;
  padding: 0;
  background: #fafaff;
}

.login-reference-shell {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: grid;
  grid-template-columns: 43% 57%;
  overflow: hidden;
  background: #f9f9fd;
  animation: loginCardIn 0.55s ease both;
}

.login-stage-back {
  position: absolute;
  z-index: 4;
  top: 20px;
  right: 20px;
  width: 42px;
  height: 42px;
  display: inline-grid;
  place-items: center;
  padding: 0;
  border-color: #deddeb;
  color: #292245;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 8px 22px rgba(38, 31, 77, 0.08);
}

.login-stage-back svg {
  width: 20px;
  height: 20px;
}

.login-stage-back:hover {
  background: #fff;
  transform: translateX(-2px);
}

.login-reference-story {
  position: relative;
  z-index: 1;
  background:
    radial-gradient(
      circle at 90% 62%,
      rgba(211, 151, 83, 0.28),
      transparent 27%
    ),
    linear-gradient(145deg, #315247, #1f3931);
  color: #fff;
  padding: clamp(42px, 6vw, 88px);
  padding-right: clamp(76px, 9vw, 140px);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%);
  margin-right: -16%;
}

.login-reference-story::after {
  content: "";
  position: absolute;
  inset: auto -90px 120px auto;
  width: 310px;
  height: 310px;
  border-radius: 50%;
  background: rgba(211, 151, 83, 0.14);
  filter: blur(12px);
  pointer-events: none;
}

.login-reference-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 17px;
}

.login-reference-logo {
  width: 52px;
  height: 52px;
  display: block;
  border-radius: 12px;
  object-fit: contain;
  background: #fff;
  box-shadow: 0 8px 22px rgba(7, 5, 19, 0.3);
}

.login-reference-message {
  position: relative;
  z-index: 1;
  max-width: 500px;
}

.login-reference-message > span {
  color: #efbd83;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.login-reference-message h1 {
  margin: 20px 0 38px;
  font-size: clamp(36px, 3.5vw, 52px);
  line-height: 1.14;
  letter-spacing: -0.035em;
}

.login-reference-chart {
  width: min(100%, 470px);
  padding: 26px 26px 18px;
  border: 1px solid rgba(255, 255, 255, 0.17);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.06);
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.05);
}

.login-chart-head,
.login-chart-days {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.login-chart-head {
  color: #d9d5ef;
  font-size: 14px;
}

.login-chart-head strong {
  color: #91ebd0;
  font-size: 13px;
}

.login-chart-bars {
  height: 132px;
  margin-top: 26px;
  display: flex;
  align-items: flex-end;
  gap: 14px;
}

.login-chart-bars i {
  flex: 1;
  min-width: 10px;
  border-radius: 4px 4px 0 0;
  background: linear-gradient(180deg, #d8a15e, #9e6337);
}

.login-chart-days {
  margin-top: 13px;
  color: #8e88aa;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(236, 247, 245, 0.72);
}

.login-stage-chip strong {
  font-size: 15px;
  font-weight: 600;
}

.login-stage-chip small {
  color: rgba(236, 247, 245, 0.76);
}

.login-reference-form-panel {
  position: relative;
  z-index: 0;
  display: grid;
  place-items: center;
  padding: 70px clamp(42px, 7vw, 110px);
  padding-left: clamp(84px, 10vw, 155px);
  background: #fafaff;
}

.login-reference-form {
  width: min(100%, 520px);
  display: grid;
  gap: 16px;
}

.login-reference-heading {
  margin-bottom: 22px;
}

.login-reference-heading h2 {
  margin: 0 0 13px;
  color: #17122f;
  font-size: 36px;
  letter-spacing: -0.03em;
}

.login-reference-heading p {
  margin: 0;
  color: #77708f;
  font-size: 15px;
  line-height: 1.65;
}

.login-reference-form label {
  color: #292242;
  font-size: 14px;
  font-weight: 600;
}

.login-reference-form > input {
  width: 100%;
  height: 64px;
  border: 1px solid #dddbea;
  border-radius: 11px;
  padding: 0 18px;
  background: #fff;
  color: #17122f;
  font-size: 15px;
  outline: none;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.login-reference-form > input:focus {
  border-color: #5f8c73;
  box-shadow: 0 0 0 3px rgba(95, 140, 115, 0.14);
}

.login-otp-heading {
  margin-top: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.login-resend {
  padding: 0;
  border: 0;
  background: transparent;
  color: #a66335;
  font-size: 13px;
}

.login-resend:hover:not(:disabled) {
  color: #754323;
}

.login-otp-cells {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 12px;
}

.login-otp-cells input {
  width: 100%;
  aspect-ratio: 1;
  min-width: 0;
  border: 1px solid #d9d7e6;
  border-radius: 11px;
  background: #fff;
  color: #17122f;
  text-align: center;
  font-size: 24px;
  font-weight: 600;
  outline: none;
}

.login-otp-cells input:focus {
  border-color: #5f8c73;
  box-shadow: 0 0 0 3px rgba(95, 140, 115, 0.14);
}

.login-reference-submit {
  width: 100%;
  min-height: 64px;
  margin-top: 16px;
  border: 0;
  border-radius: 11px;
  background: linear-gradient(135deg, #5f8c73, #3f6b58);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  box-shadow: 0 12px 25px rgba(63, 107, 88, 0.25);
}

.login-reference-submit:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 15px 30px rgba(63, 107, 88, 0.32);
}

.login-reference-help {
  margin: 12px 0 0;
  color: #9a95ad;
  text-align: center;
  font-size: 12px;
}

.login-reference-form .delete-note {
  margin: 4px 0 0;
  color: #6d628d;
  text-align: center;
}

@keyframes loginBlobFloat {
  0%,
  100% {
    transform: translate3d(0, 0, 0) scale(1);
  }
  50% {
    transform: translate3d(22px, -26px, 0) scale(1.08);
  }
}

@keyframes loginAuraShift {
  from {
    transform: translate3d(0, 0, 0) scale(1);
  }
  to {
    transform: translate3d(0, -16px, 0) scale(1.06);
  }
}

@keyframes loginPulse {
  0%,
  100% {
    transform: scale(0.96);
    opacity: 0.46;
  }
  50% {
    transform: scale(1.08);
    opacity: 0.9;
  }
}

@keyframes loginCardIn {
  from {
    opacity: 0;
    transform: translateY(18px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.empty-state {
  background: #fff;
  border: 1px dashed rgba(17, 44, 50, 0.18);
  border-radius: 22px;
  padding: 24px;
  color: #516267;
}

.empty-state strong {
  display: block;
  color: #112c32;
  margin-bottom: 8px;
}

.telemetry-chat-json {
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.76);
  border: 1px solid rgba(17, 44, 50, 0.08);
  overflow: hidden;
}

.telemetry-chat-json summary {
  cursor: pointer;
  list-style: none;
  padding: 11px 13px;
  font-size: 12px;
  font-weight: 700;
  color: #17383e;
}

.telemetry-chat-json summary::-webkit-details-marker {
  display: none;
}

.telemetry-chat-json pre {
  margin: 0;
  padding: 0 13px 13px;
  overflow-x: auto;
  color: #27454a;
  font-size: 11px;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.dashboard-section-head {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.attendance-dashboard {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.attendance-toolbar {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.attendance-title-block {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.attendance-title-block h2 {
  margin: 0;
}

.attendance-toolbar-row {
  display: grid;
  gap: 18px;
  align-items: end;
}

.attendance-section-head {
  align-items: flex-start;
  margin-bottom: 0;
}

.attendance-section-head .attendance-head-actions {
  flex: 0 1 auto;
  width: auto;
  justify-content: flex-end;
}

.attendance-section-head .attendance-controls-inline {
  width: auto;
  flex: 0 1 auto;
  justify-content: flex-end;
}

.attendance-section-head .attendance-controls-inline > .dashboard-button {
  margin-left: auto;
}

.attendance-controls {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: flex-end;
}

.attendance-head-actions {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: flex-end;
  align-items: flex-end;
  margin-left: 0;
}

.attendance-controls-inline {
  display: flex;
  width: 100%;
  justify-content: flex-end;
  align-items: flex-end;
  gap: 12px;
  flex-wrap: wrap;
}

.attendance-quick-actions {
  position: relative;
}

.attendance-quick-trigger {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.attendance-quick-trigger span {
  min-width: 24px;
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(17, 44, 50, 0.08);
  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
}

.attendance-quick-menu {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  width: min(280px, 80vw);
  padding: 10px;
  border-radius: 18px;
  background: #fff;
  border: 1px solid rgba(17, 44, 50, 0.08);
  box-shadow: 0 18px 40px rgba(17, 44, 50, 0.12);
  display: grid;
  gap: 6px;
  opacity: 0;
  transform: translateY(-6px) scale(0.98);
  pointer-events: none;
  transition:
    opacity 0.2s ease,
    transform 0.22s ease;
  z-index: 40;
}

.attendance-quick-menu.open {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.attendance-quick-item {
  width: 100%;
  text-align: left;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: #17383e;
  padding: 12px 14px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition:
    background 0.18s ease,
    color 0.18s ease;
}

.attendance-quick-item:hover:not(:disabled) {
  background: #f3f8f6;
  color: #0f4449;
}

.attendance-quick-item:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.attendance-tabs {
  margin-top: 0;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.attendance-tab {
  border: 1px solid rgba(17, 44, 50, 0.12);
  background: rgba(255, 255, 255, 0.9);
  color: #24343a;
  min-height: 42px;
  padding: 9px 15px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  box-shadow: 0 10px 24px rgba(17, 44, 50, 0.06);
  transition:
    background 0.22s ease,
    border-color 0.22s ease,
    color 0.22s ease,
    transform 0.22s ease,
    box-shadow 0.22s ease;
}

.attendance-tab:hover {
  transform: translateY(-1px);
  border-color: rgba(17, 44, 50, 0.2);
  box-shadow: 0 14px 28px rgba(17, 44, 50, 0.1);
}

.attendance-tab:focus-visible {
  outline: none;
  border-color: #6ca59a;
  box-shadow: 0 0 0 4px rgba(108, 165, 154, 0.16);
}

.attendance-tab span {
  background: rgba(17, 44, 50, 0.07);
  color: #112c32;
  min-width: 28px;
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.2;
  text-align: center;
}

.attendance-tab.active {
  background: #0f5a45;
  color: #ffffff;
  border-color: #0f5a45;
  box-shadow: 0 12px 26px rgba(15, 90, 69, 0.18);
}

.attendance-tab.active span {
  background: #c9f556;
  color: #123f35;
}

.report-status {
  font-size: 12px;
  color: #4b5c61;
  align-self: center;
}

.attendance-report-status {
  align-self: flex-end;
}

.attendance-content-card {
  overflow: hidden;
  box-shadow: 0 10px 26px rgba(15, 23, 42, 0.05);
  border-color: #e6ebf2;
}

.attendance-missed-panel {
  width: min(460px, 92vw);
}

.attendance-missed-panel .alert-side-count,
.attendance-missed-panel .missed-logins-toolbar,
.attendance-missed-panel .missed-logins-actions,
.attendance-missed-panel .alert-side-list {
  margin: 0;
}

.employee-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: center;
}

.employee-export-format {
  border-radius: 18px;
  border: 1px solid rgba(17, 44, 50, 0.12);
  padding: 13px 16px;
  font-size: 13px;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.92);
  color: #112c32;
}

.employee-export-status {
  display: block;
  margin-top: 8px;
}

.attendance-filter {
  display: grid;
  gap: 8px;
  font-size: 12px;
  color: #4b5c61;
  position: relative;
  align-self: end;
}

.attendance-filter-date {
  min-width: 248px;
  flex: 0 1 280px;
}

.attendance-filter-search {
  min-width: 300px;
  max-width: 420px;
  flex: 1 1 360px;
}

.attendance-filter-compact {
  min-width: 88px;
}

.attendance-filter input,
.attendance-filter select,
.attendance-input-shell {
  border-radius: 18px;
  border: 1px solid rgba(17, 44, 50, 0.12);
  padding: 13px 16px;
  font-size: 13px;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.92);
  color: #112c32;
  box-shadow:
    0 12px 28px rgba(17, 44, 50, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  transition:
    border-color 0.22s ease,
    box-shadow 0.22s ease,
    transform 0.22s ease,
    background-color 0.22s ease;
}

.attendance-input-shell {
  min-height: 52px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 14px;
  position: relative;
  width: 100%;
}

.attendance-filter label {
  padding-left: 4px;
  font-size: 12px;
  font-weight: 500;
  color: #607277;
}

.attendance-filter input::placeholder,
.attendance-filter select::placeholder {
  color: #8b989c;
}

.attendance-filter input:hover,
.attendance-filter select:hover,
.attendance-input-shell:hover {
  border-color: rgba(17, 44, 50, 0.18);
  box-shadow:
    0 14px 30px rgba(17, 44, 50, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.98);
}

.attendance-filter input:focus,
.attendance-filter select:focus,
.attendance-input-shell:focus-within {
  outline: none;
  border-color: #72afa4;
  background: #ffffff;
  transform: translateY(-1px);
  box-shadow:
    0 18px 34px rgba(17, 44, 50, 0.1),
    0 0 0 4px rgba(114, 175, 164, 0.16);
}

.attendance-filter:focus-within label {
  color: #2f5b62;
}

.attendance-input-shell input {
  border: none;
  box-shadow: none;
  background: transparent;
  width: 100%;
  min-height: 50px;
  padding: 0;
  color: #112c32;
}

.attendance-input-shell input:hover,
.attendance-input-shell input:focus {
  border: none;
  box-shadow: none;
  transform: none;
  background: transparent;
}

.attendance-search-shell {
  padding-right: 18px;
}

.attendance-filter-search {
  position: relative;
}

.attendance-filter-search::after {
  content: "";
  position: absolute;
  right: 20px;
  bottom: 17px;
  width: 16px;
  height: 16px;
  border: 2px solid rgba(95, 114, 119, 0.7);
  border-radius: 50%;
  pointer-events: none;
  transition:
    border-color 0.22s ease,
    transform 0.22s ease;
}

.attendance-filter-search::before {
  content: "";
  position: absolute;
  right: 16px;
  bottom: 14px;
  width: 7px;
  height: 2px;
  background: rgba(95, 114, 119, 0.7);
  border-radius: 999px;
  transform: rotate(45deg);
  transform-origin: center;
  pointer-events: none;
  transition:
    background-color 0.22s ease,
    transform 0.22s ease;
}

.attendance-filter-search:focus-within::after {
  border-color: #2f5b62;
  transform: scale(1.06);
}

.attendance-filter-search:focus-within::before {
  background: #2f5b62;
  transform: rotate(45deg) scale(1.06);
}

.employee-search-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
  padding: 18px 20px;
  border-radius: 24px;
  background:
    radial-gradient(
      circle at top left,
      rgba(31, 167, 164, 0.14),
      transparent 42%
    ),
    linear-gradient(135deg, #f7fbfa, #eef5f2);
  border: 1px solid rgba(17, 44, 50, 0.08);
}

.exception-head-copy {
  margin: 10px 0 0;
  color: #607076;
  font-size: 14px;
  line-height: 1.55;
  max-width: 620px;
}

.calendar-head-copy {
  margin: 10px 0 0;
  color: #5f6d72;
  font-size: 14px;
  line-height: 1.55;
  max-width: 640px;
}

.calendar-head-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.calendar-shell {
  display: grid;
}

.calendar-card {
  background:
    radial-gradient(
      circle at top right,
      rgba(17, 44, 50, 0.04),
      transparent 28%
    ),
    linear-gradient(145deg, #ffffff, #f7f7f5);
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 28px;
  padding: 22px 24px 24px;
  box-shadow: 0 14px 30px rgba(17, 44, 50, 0.06);
  display: grid;
  gap: 18px;
}

.calendar-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18px;
  flex-wrap: wrap;
}

.calendar-card-head span {
  display: block;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #6d7a7e;
}

.calendar-card-head strong {
  display: block;
  margin-top: 6px;
  color: #112c32;
  font-size: 26px;
}

.calendar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
}

.calendar-legend span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(17, 44, 50, 0.08);
  font-size: 12px;
  color: #3f5055;
  text-transform: none;
  letter-spacing: 0;
}

.calendar-dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  display: inline-block;
}

.calendar-dot.attendance {
  background: #23393f;
}

.calendar-dot.leave {
  background: #7f8b8e;
}

.calendar-dot.exception {
  background: #566569;
}

.calendar-weekdays,
.calendar-grid-page {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 12px;
}

.calendar-weekdays span {
  text-align: center;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #748287;
  padding: 4px 0 6px;
}

.calendar-day-card {
  position: relative;
  min-height: 156px;
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.94);
  padding: 14px;
  text-align: left;
  display: grid;
  gap: 14px;
  overflow: hidden;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.calendar-day-card:hover {
  transform: translateY(-1px);
  border-color: rgba(17, 44, 50, 0.14);
  box-shadow: 0 12px 22px rgba(17, 44, 50, 0.06);
}

.calendar-day-card.outside {
  opacity: 0.45;
}

.calendar-day-card.today {
  border-color: rgba(17, 44, 50, 0.24);
  box-shadow: inset 0 0 0 1px rgba(17, 44, 50, 0.06);
}

.calendar-day-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.calendar-day-number {
  font-size: 20px;
  font-weight: 600;
  color: #112c32;
}

.calendar-day-badge {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #22363c;
  background: rgba(17, 44, 50, 0.08);
  border-radius: 999px;
  padding: 5px 8px;
}

.calendar-day-heat {
  position: absolute;
  inset: auto 12px 54px 12px;
  height: 44px;
  border-radius: 16px;
  z-index: 0;
}

.calendar-day-stats {
  position: relative;
  z-index: 1;
  margin-top: auto;
  display: grid;
  gap: 6px;
}

.calendar-day-stats span {
  font-size: 12px;
  color: #55656a;
}

.exception-card-list {
  display: grid;
  gap: 18px;
}

.exception-card {
  width: 100%;
  background:
    radial-gradient(
      circle at top right,
      rgba(31, 167, 164, 0.1),
      transparent 34%
    ),
    linear-gradient(135deg, #ffffff, #f7fbfa);
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 28px;
  padding: 22px 24px;
  display: grid;
  gap: 18px;
  box-shadow: 0 18px 36px rgba(17, 44, 50, 0.08);
}

.exception-card.early {
  background:
    radial-gradient(
      circle at top right,
      rgba(255, 173, 70, 0.14),
      transparent 34%
    ),
    linear-gradient(135deg, #ffffff, #fbf8f1);
}

.exception-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18px;
  flex-wrap: wrap;
}

.exception-card-top h3 {
  margin: 6px 0 0;
  color: #112c32;
  font-size: 24px;
}

.exception-card-kicker {
  margin: 0;
  font-size: 11px;
  font-weight: 500;
  color: #1fa7a4;
}

.exception-card-pills {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.exception-card-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.exception-card-stat {
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(17, 44, 50, 0.06);
  border-radius: 18px;
  padding: 14px 16px;
}

.exception-card-stat span {
  display: block;
  font-size: 11px;
  font-weight: 400;
  color: #6b7b80;
}

.exception-card-stat strong {
  display: block;
  margin-top: 8px;
  color: #112c32;
  font-size: 18px;
}

.exception-card-reason {
  display: grid;
  gap: 8px;
  padding: 16px 18px;
  border-radius: 20px;
  background: rgba(17, 44, 50, 0.04);
}

.exception-card-reason span {
  font-size: 11px;
  font-weight: 400;
  color: #6b7b80;
}

.exception-card-reason p {
  margin: 0;
  color: #273c42;
  font-size: 14px;
  line-height: 1.6;
}

.employee-search-copy {
  display: grid;
  gap: 4px;
}

.employee-search-copy label {
  font-size: 12px;
  font-weight: 500;
  color: #4b5c61;
}

.employee-search-copy span {
  font-size: 13px;
  color: #607076;
}

.employee-search-shell {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: min(420px, 100%);
  padding: 6px 8px 6px 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(17, 44, 50, 0.1);
  box-shadow: 0 10px 26px rgba(17, 44, 50, 0.06);
}

.employee-search-shell:focus-within {
  border-color: rgba(31, 167, 164, 0.45);
  box-shadow: 0 14px 32px rgba(31, 167, 164, 0.14);
}

.employee-search-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 999px;
  background: #edf5f3;
  color: #2f5b62;
  flex-shrink: 0;
}

.employee-search-icon svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

.employee-search-shell input {
  flex: 1;
  min-width: 0;
  border: none;
  background: transparent;
  color: #112c32;
  font-size: 14px;
  padding: 8px 0;
}

.employee-search-shell input:focus {
  outline: none;
}

.employee-search-clear {
  border: none;
  background: #112c32;
  color: #fff;
  border-radius: 999px;
  padding: 9px 14px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  flex-shrink: 0;
}

.employee-toolbar-meta {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.employee-filter-chip {
  display: inline-flex;
  align-items: center;
  min-height: 36px;
  padding: 0 12px;
  border-radius: 8px;
  background: rgba(17, 44, 50, 0.07);
  color: #204047;
  font-size: 12px;
  font-weight: 500;
}

.employee-blood-filter {
  display: grid;
  gap: 6px;
}

.employee-blood-filter label {
  font-size: 12px;
  font-weight: 500;
  color: #4b5c61;
}

.employee-blood-filter select {
  min-width: 128px;
  border-radius: 999px;
  border: 1px solid rgba(17, 44, 50, 0.2);
  background: rgba(255, 255, 255, 0.94);
  color: #112c32;
  font-size: 13px;
  padding: 9px 34px 9px 12px;
}

.employee-blood-filter select:focus {
  outline: none;
  border-color: #6ca59a;
  box-shadow: 0 0 0 3px rgba(108, 165, 154, 0.16);
}

.employee-status-head {
  position: relative;
}

.employee-status-filter {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.employee-status-filter-trigger {
  width: 28px;
  height: 28px;
  border-radius: 10px;
  border: 1px solid rgba(17, 44, 50, 0.12);
  background: #fff;
  color: #5c6e73;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}

.employee-status-filter-trigger:hover,
.employee-status-filter-trigger.open {
  color: #0f4449;
  border-color: rgba(31, 167, 164, 0.4);
  box-shadow: 0 10px 18px rgba(17, 44, 50, 0.08);
  transform: translateY(-1px);
}

.employee-status-filter-trigger svg {
  width: 16px;
  height: 16px;
}

.employee-status-menu {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  z-index: 40;
  min-width: 176px;
  border-radius: 18px;
  border: 1px solid rgba(17, 44, 50, 0.1);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 18px 36px rgba(17, 44, 50, 0.12);
  padding: 8px;
  backdrop-filter: blur(12px);
}

.employee-status-menu-item {
  width: 100%;
  border: none;
  background: transparent;
  color: #173239;
  text-align: left;
  padding: 10px 12px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition:
    background-color 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

.employee-status-menu-item:hover,
.employee-status-menu-item.active {
  background: #ecf7f4;
  color: #0f4449;
  transform: translateX(2px);
}

.search-field {
  display: grid;
  gap: 6px;
  font-size: 12px;
  color: #4b5c61;
  min-width: 220px;
  max-width: 360px;
  flex: 1;
}

.search-field input {
  border-radius: 999px;
  border: 1px solid rgba(17, 44, 50, 0.2);
  padding: 8px 12px;
  font-size: 13px;
  background: #fff;
  color: #112c32;
}

.muted-email {
  font-size: 11px;
  color: #6b7b80;
}

.dashboard-section-head h2 {
  margin: 8px 0 0;
  font-size: 30px;
  color: #112c32;
}

.dashboard-button {
  white-space: nowrap;
}

.dashboard-button.ghost.active {
  background: #112c32;
  color: #fff;
  border-color: #112c32;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 22px;
}

.chart-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 18px;
  margin-bottom: 22px;
}

.chart-card {
  background: #fff;
  border-radius: 22px;
  padding: 18px 20px;
  border: 1px solid rgba(17, 44, 50, 0.08);
  display: grid;
  gap: 12px;
}

.chart-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.chart-card-head span {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #607076;
}

.reports-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(280px, 0.85fr);
  gap: 18px;
}

.reports-main,
.reports-aside {
  display: grid;
  gap: 18px;
  align-content: start;
}

.dashboard-analytics-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr);
  gap: 18px;
}

.dashboard-analytics-card {
  min-width: 0;
  padding: 24px;
  border: 1px solid #dfe4ee;
  border-radius: 16px;
  background: #fff;
}

.dashboard-analytics-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.dashboard-analytics-head strong {
  color: #0d2140;
  font-size: 15px;
}

.dashboard-analytics-head span {
  color: #8b96a9;
  font-size: 12px;
}

.weekly-attendance-bars {
  height: 150px;
  margin-top: 22px;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: clamp(8px, 2vw, 24px);
}

.weekly-attendance-column {
  min-width: 0;
  display: grid;
  grid-template-rows: 1fr auto;
  gap: 9px;
  justify-items: center;
}

.weekly-attendance-bar-shell {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.weekly-attendance-bar {
  width: min(100%, 36px);
  min-height: 6px;
  border-radius: 6px 6px 0 0;
  background: linear-gradient(180deg, #78aa8e, #4f806a);
  transition: height 0.3s ease;
}

.weekly-attendance-bar.current {
  background: linear-gradient(180deg, #d9a25f, #b96f37);
}

.weekly-attendance-column > span {
  color: #8995a8;
  font-size: 11px;
}

.weekly-attendance-column > span.current {
  color: #13294c;
  font-weight: 600;
}

.weekly-attendance-metrics {
  margin-top: 18px;
  padding-top: 17px;
  border-top: 1px solid #e8ebf1;
  display: flex;
  gap: 34px;
  flex-wrap: wrap;
}

.weekly-attendance-metrics div {
  display: grid;
  gap: 2px;
}

.weekly-attendance-metrics span {
  color: #8b96a9;
  font-size: 11px;
}

.weekly-attendance-metrics strong {
  color: #0d2140;
  font-size: 18px;
}

.department-attendance-list {
  margin-top: 20px;
  display: grid;
  gap: 17px;
}

.department-attendance-row {
  display: grid;
  gap: 7px;
}

.department-attendance-row > div:first-child {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: #172b49;
  font-size: 12px;
}

.department-attendance-row > div:first-child strong {
  color: #7f8ba0;
  font-weight: 600;
}

.department-attendance-track {
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: #e9edf4;
}

.department-attendance-track div {
  height: 100%;
  min-width: 3px;
  border-radius: inherit;
  background: linear-gradient(90deg, #4f806a, #91b8a2);
}

.report-toolbar,
.report-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.report-toolbar {
  order: -1;
}

.report-actions-card,
.alert-side-card {
  background: #fff;
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 22px;
  padding: 18px 20px;
  display: grid;
  gap: 16px;
}

.report-actions-card span {
  color: #607076;
  font-size: 12px;
}

/* Heatmap / weekly-trend switch inside the primary reports chart card. */
.chart-view-switch {
  gap: 8px;
  flex-shrink: 0;
}

.chart-view-switch .dashboard-button {
  padding: 6px 14px;
  font-size: 12px;
}

.line-chart-shell {
  display: grid;
  gap: 14px;
}

.line-chart {
  width: 100%;
  height: 220px;
  overflow: visible;
}

.line-chart-labels {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10px;
}

.chart-label-block {
  text-align: center;
}

.chart-label-block strong {
  display: block;
  font-size: 16px;
  color: #112c32;
}

.chart-label-block span {
  font-size: 12px;
  color: #607076;
}

.efficiency-list {
  display: grid;
  gap: 12px;
}

.efficiency-row {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(160px, 1fr) 64px;
  gap: 12px;
  align-items: center;
}

.efficiency-meta span {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #607076;
}

.efficiency-bar-track {
  height: 10px;
  border-radius: 999px;
  background: #e7eeeb;
  overflow: hidden;
}

.efficiency-bar-fill {
  height: 100%;
  border-radius: inherit;
  background: #112c32;
}

.efficiency-score {
  text-align: right;
  color: #112c32;
}

.alert-side-count {
  display: grid;
  gap: 4px;
  padding: 14px 16px;
  border-radius: 18px;
  background: #f4f6f4;
}

.alert-side-count strong {
  font-size: 32px;
  color: #112c32;
}

.alert-side-count span {
  font-size: 12px;
  color: #607076;
}

.alert-side-list {
  display: grid;
  gap: 10px;
}

.alert-side-item {
  padding: 12px 14px;
  border-radius: 16px;
  background: #f8faf8;
  border: 1px solid rgba(17, 44, 50, 0.08);
}

.alert-side-item span {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #607076;
}

.missed-login-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
}

.missed-login-checkbox {
  width: 16px;
  height: 16px;
  margin-top: 2px;
  flex-shrink: 0;
  accent-color: #112c32;
  cursor: pointer;
}

.missed-login-item-copy {
  display: grid;
}

.missed-login-item.sent {
  cursor: not-allowed;
  opacity: 0.72;
}

.missed-login-item.sent .missed-login-checkbox {
  cursor: not-allowed;
}

.missed-login-alert-sent {
  font-size: 11px;
  font-weight: 600;
  color: #2e7d58;
}

.missed-login-alert-not-sent {
  font-size: 11px;
  font-weight: 600;
  color: #607076;
}

.missed-logins-toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  flex-wrap: wrap;
}

.missed-logins-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.missed-logins-selected {
  font-size: 12px;
  color: #607076;
}

.alert-trigger-wrap {
  position: relative;
}

.alert-trigger-button {
  min-width: 150px;
}

.alert-trigger-dropdown {
  position: absolute;
  top: calc(100% + 12px);
  right: 0;
  width: min(360px, 82vw);
  padding: 18px;
  border-radius: 22px;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.98),
    rgba(244, 249, 247, 0.98)
  );
  border: 1px solid rgba(17, 44, 50, 0.08);
  box-shadow: 0 24px 60px rgba(17, 44, 50, 0.16);
  display: grid;
  gap: 14px;
  opacity: 0;
  transform: translateY(-8px) scale(0.98);
  pointer-events: none;
  transition:
    opacity 0.24s ease,
    transform 0.28s ease;
  transform-origin: top right;
  z-index: 25;
}

.alert-trigger-dropdown.open {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.alert-trigger-dropdown-head {
  display: grid;
  gap: 4px;
}

.alert-trigger-dropdown-head strong {
  font-size: 16px;
  color: #112c32;
}

.alert-trigger-dropdown-head span {
  font-size: 12px;
  color: #607076;
}

.alert-trigger-message {
  padding: 14px 16px;
  border-radius: 18px;
  background: #f6faf8;
  border: 1px solid rgba(17, 44, 50, 0.07);
  display: grid;
  gap: 6px;
}

.alert-trigger-message small {
  font-size: 11px;
  font-weight: 400;
  color: #607076;
}

.alert-trigger-message strong {
  color: #112c32;
}

.alert-trigger-message p {
  margin: 0;
  font-size: 13px;
  line-height: 1.5;
  color: #4b5c61;
}

.alert-trigger-recipient-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.alert-trigger-recipient-pill {
  display: inline-flex;
  align-items: center;
  padding: 8px 12px;
  border-radius: 999px;
  background: #eaf3f0;
  color: #21464b;
  font-size: 12px;
  font-weight: 600;
}

.alert-trigger-dropdown-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  flex-wrap: wrap;
}

.chart-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
}

.chart-head span {
  font-size: 12px;
  color: #607076;
}

.donut-wrap {
  position: relative;
  width: 140px;
  height: 140px;
  margin: 0 auto;
}

.donut-chart {
  transform: rotate(-90deg);
}

.donut-bg {
  fill: none;
  stroke: #e6eeec;
  stroke-width: 12;
}

.donut-progress {
  fill: none;
  stroke: #1fa7a4;
  stroke-width: 12;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.6s ease;
}

.donut-center {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  text-align: center;
}

.donut-center strong {
  font-size: 20px;
}

.donut-center span {
  font-size: 12px;
  color: #607076;
}

.bar-chart {
  display: grid;
  gap: 12px;
}

.bar-row {
  display: grid;
  grid-template-columns: 100px 1fr 50px;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  color: #4b5c61;
}

.bar-track {
  height: 10px;
  background: #edf2f1;
  border-radius: 999px;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999px;
  transition: width 0.4s ease;
}

.bar-fill.attendance {
  background: #1fa7a4;
}

.bar-fill.compoff {
  background: #ffad46;
}

.metric-card {
  background: #ffffff;
  border-radius: 22px;
  padding: 18px 20px;
  border: 1px solid rgba(17, 44, 50, 0.08);
}

.metric-button {
  width: 100%;
  text-align: left;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease;
}

.metric-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 30px rgba(17, 44, 50, 0.08);
}

.metric-button.active {
  border-color: rgba(31, 167, 164, 0.45);
  background: #eef8f5;
}

.metric-card span {
  display: block;
  font-size: 13px;
  color: #5f6d72;
}

.metric-card strong {
  display: block;
  margin-top: 8px;
  font-size: 34px;
  color: #112c32;
}

.metric-card small {
  display: block;
  margin-top: 10px;
  font-size: 12px;
  color: #66777c;
}

.data-card {
  display: grid;
  gap: 14px;
}

.table-card {
  background: #fff;
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 24px;
  overflow: hidden;
}

.table-scroll {
  width: 100%;
  overflow-x: auto;
}

.dashboard-table {
  width: 100%;
  min-width: 760px;
  border-collapse: separate;
  border-spacing: 0;
}

.dashboard-table thead th {
  padding: 14px 18px;
  text-align: left;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #58686d;
  background: #f4f6f4;
  border-bottom: 1px solid rgba(17, 44, 50, 0.1);
}

.dashboard-table tbody td {
  padding: 16px 18px;
  vertical-align: top;
  border-bottom: 1px solid rgba(17, 44, 50, 0.08);
  color: #112c32;
  font-size: 14px;
}

.dashboard-table tbody tr:last-child td {
  border-bottom: none;
}

.table-clickable-row {
  cursor: pointer;
}

.table-clickable-row:hover td {
  background: #f8faf8;
}

.dashboard-table strong {
  display: block;
  color: #112c32;
  font-size: 14px;
}

.table-meta {
  display: block;
  margin-top: 4px;
  color: #607076;
  font-size: 12px;
  line-height: 1.45;
}

.table-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.table-card .empty-state {
  margin: 16px;
}

.data-row {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(120px, 0.6fr) minmax(
      120px,
      0.5fr
    );
  gap: 16px;
  align-items: center;
  padding: 18px 20px;
  border-radius: 22px;
  background: #fff;
  border: 1px solid rgba(17, 44, 50, 0.08);
}

.location-cell {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.location-details {
  display: grid;
  gap: 6px;
  font-size: 12px;
  color: #4b5c61;
}

.location-name {
  display: block;
  color: #112c32;
  font-size: 13px;
  font-weight: 600;
  margin-top: 2px;
}

.location-address {
  display: block;
  margin-top: 2px;
}

.location-label {
  display: block;
  font-size: 11px;
  font-weight: 400;
  color: #7a8b90;
  margin-bottom: 2px;
}

.map-button {
  border: none;
  background: #e6f4f3;
  color: #0f4449;
  width: 32px;
  height: 32px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
}

.map-button svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

.map-button:hover {
  background: #d6eeec;
}

.map-dialog-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 31, 35, 0.45);
  backdrop-filter: blur(2px);
  display: grid;
  place-items: center;
  z-index: 1000;
  padding: 18px;
  overflow-y: auto;
}

.side-panel-scrim {
  position: fixed;
  inset: 0;
  border: none;
  background: rgba(17, 44, 50, 0.2);
  z-index: 1100;
}

.field-visit-panel {
  position: fixed;
  top: 0;
  right: 0;
  width: min(440px, 92vw);
  height: 100vh;
  background: #ffffff;
  border-left: 1px solid rgba(17, 44, 50, 0.08);
  box-shadow: -16px 0 40px rgba(17, 44, 50, 0.12);
  z-index: 1101;
  padding: 24px 20px;
  overflow-y: auto;
  display: grid;
  align-content: start;
  gap: 18px;
}

.field-visit-panel-head {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}

.field-visit-panel-head h3 {
  margin: 6px 0 4px;
  font-size: 24px;
  color: #112c32;
}

.field-visit-panel-head span {
  font-size: 12px;
  color: #607076;
}

.field-visit-panel-close {
  border: 1px solid rgba(17, 44, 50, 0.12);
  background: #fff;
  color: #112c32;
  border-radius: 999px;
  padding: 8px 14px;
  cursor: pointer;
}

.field-visit-panel-summary {
  display: grid;
  gap: 12px;
}

.field-visit-panel-card {
  background: #f8faf8;
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 18px;
  padding: 14px 16px;
}

.field-visit-panel-card span {
  display: block;
  font-size: 11px;
  font-weight: 400;
  color: #607076;
}

.field-visit-panel-card strong {
  display: block;
  margin-top: 6px;
  color: #112c32;
}

.field-visit-panel-card small {
  display: block;
  margin-top: 6px;
  color: #607076;
  line-height: 1.5;
}

.field-visit-panel-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  color: #607076;
  font-size: 12px;
}

.field-visit-timeline {
  display: grid;
  gap: 14px;
}

.field-visit-timeline-item {
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr);
  gap: 12px;
  align-items: start;
}

.field-visit-timeline-icon {
  width: 16px;
  height: 16px;
  margin-top: 4px;
  border-radius: 999px;
  background: #1fa7a4;
  position: relative;
}

.field-visit-timeline-item.start .field-visit-timeline-icon {
  background: #34a853;
}

.field-visit-timeline-item.end .field-visit-timeline-icon {
  background: #ea4335;
}

.field-visit-timeline-icon::after {
  content: "";
  position: absolute;
  top: 18px;
  left: 7px;
  width: 2px;
  height: calc(100% + 26px);
  background: #d9e4e1;
}

.field-visit-timeline-item:last-child .field-visit-timeline-icon::after {
  display: none;
}

.field-visit-timeline-content {
  background: #fff;
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 16px;
  padding: 12px 14px;
}

.field-visit-timeline-content strong {
  display: block;
  color: #112c32;
}

.field-visit-timeline-content span,
.field-visit-timeline-content small {
  display: block;
  margin-top: 4px;
  color: #607076;
  line-height: 1.45;
}

.map-dialog {
  width: min(1020px, 96vw);
  max-height: 92vh;
  background: #f1eef6;
  border: 1px solid rgba(28, 38, 56, 0.12);
  border-radius: 22px;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(17, 44, 50, 0.24);
  display: flex;
  flex-direction: column;
}

.map-dialog-header {
  padding: 14px 22px 12px;
  background: #f1eef6;
  border-bottom: 1px solid rgba(28, 38, 56, 0.1);
}

.map-dialog-header strong {
  display: block;
  font-size: clamp(28px, 3.1vw, 44px);
  font-weight: 600;
  line-height: 1.08;
  color: #20293d;
}

.map-dialog-body {
  display: block;
  flex: 1 1 auto;
  overflow-y: auto;
  background: #f1eef6;
}

.map-dialog-body::-webkit-scrollbar {
  width: 10px;
}

.map-dialog-body::-webkit-scrollbar-track {
  background: transparent;
}

.map-dialog-body::-webkit-scrollbar-thumb {
  background: rgba(56, 69, 95, 0.35);
  border-radius: 999px;
}

.map-dialog-body {
  scrollbar-width: thin;
  scrollbar-color: rgba(56, 69, 95, 0.35) transparent;
}

.map-dialog-meta {
  padding: 14px 22px 10px;
  background: #f1eef6;
  display: grid;
  gap: 12px;
}

.map-dialog-body iframe {
  width: 100%;
  height: 100%;
  border: 0;
}

.map-dialog-map {
  width: 100%;
  height: clamp(300px, 52vh, 500px);
  border-top: 1px solid rgba(53, 55, 68, 0.08);
  border-bottom: 1px solid rgba(53, 55, 68, 0.12);
  background: #d8dde8;
}

.map-dialog-map.leaflet-container {
  width: 100%;
  height: clamp(300px, 52vh, 500px);
}

.map-dialog-chip-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.map-dialog-chip {
  border: 1px solid rgba(61, 76, 132, 0.2);
  color: #3d4357;
  background: #f7f5fb;
  padding: 7px 14px;
  border-radius: 11px;
  font-size: 15px;
  font-weight: 500;
}

.map-dialog-coords-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px 12px;
  color: #2a3144;
  font-size: 17px;
}

.map-dialog-coords-row div {
  border: 1px solid rgba(61, 76, 132, 0.15);
  background: #f8f9fc;
  border-radius: 10px;
  padding: 8px 12px;
}

.map-dialog-points {
  display: grid;
  gap: 8px;
}

.map-dialog-points strong {
  font-size: 24px;
  color: #21293d;
  letter-spacing: 0.01em;
}

.map-dialog-points ol {
  margin: 0;
  padding: 10px 12px 10px 30px;
  border-radius: 12px;
  border: 1px solid rgba(61, 76, 132, 0.16);
  background: #f3f6ff;
  max-height: 250px;
  overflow-y: auto;
  scrollbar-gutter: stable;
  font-size: 14px;
  color: #2f3346;
  line-height: 1.5;
}

.map-dialog-empty-points {
  border-radius: 12px;
  border: 1px solid rgba(61, 76, 132, 0.15);
  padding: 12px 14px;
  color: #555f78;
  background: #f8f9fc;
  font-size: 15px;
}

.map-dialog-state {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: #5b6b70;
  font-size: 14px;
  background: #f1f2f2;
  grid-row: 1 / -1;
}

.map-dialog-footer {
  padding: 10px 22px 16px;
  display: flex;
  justify-content: flex-end;
  background: #f1eef6;
  border-top: 1px solid rgba(28, 38, 56, 0.1);
}

.map-dialog-close {
  background: #ffffff;
  border: 1px solid rgba(111, 92, 164, 0.28);
  color: #5f4a98;
  border-radius: 999px;
  padding: 7px 16px;
  font-size: 16px;
  font-weight: 600;
  line-height: 1;
  cursor: pointer;
  transition: all 0.2s ease;
}

.map-dialog-close:hover {
  background: #f4f0ff;
  border-color: rgba(111, 92, 164, 0.44);
}

.employee-row {
  grid-template-columns:
    minmax(0, 1.6fr)
    minmax(160px, 0.9fr)
    minmax(160px, 0.9fr)
    minmax(210px, 1.15fr)
    minmax(210px, 1.05fr)
    minmax(140px, 0.75fr);
}

.attendance-row {
  grid-template-columns:
    minmax(0, 1.2fr)
    minmax(220px, 1fr)
    minmax(220px, 1fr)
    minmax(120px, 0.5fr);
}

.exception-row {
  grid-template-columns: minmax(0, 1.4fr) minmax(140px, 0.9fr) minmax(
      140px,
      0.7fr
    );
}

.employee-row strong {
  font-size: 13px;
}

.employee-email {
  font-size: 11px;
  line-height: 1.35;
}

.employee-row span {
  font-size: 10.5px;
}

.employee-row strong,
.employee-row span {
  word-break: break-word;
}

.employee-row .employee-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: nowrap;
}

.data-row strong,
.data-row span {
  display: block;
}

.form-card {
  background: #fff;
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 24px;
  padding: 20px;
  display: grid;
  gap: 16px;
  margin-bottom: 18px;
}

.form-head strong,
.form-head span {
  display: block;
}

.form-head span {
  margin-top: 4px;
  font-size: 12px;
  color: #63757a;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
}

.form-grid label {
  display: block;
  margin-bottom: 6px;
  font-size: 12px;
  color: #4b5c61;
}

.form-grid input,
.form-grid select {
  width: 100%;
  border-radius: 12px;
  border: 1px solid rgba(17, 44, 50, 0.16);
  padding: 10px 12px;
  background: #fff;
  color: #112c32;
  font-size: 13px;
}

.form-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.alert-employee-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 14px;
}

.alert-filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
}

.alert-toggle {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #34464c;
  font-size: 13px;
  font-weight: 500;
}

.alert-filter-meta {
  font-size: 12px;
  color: #607076;
}

.alert-employee-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  border-radius: 18px;
  border: 1px solid rgba(17, 44, 50, 0.1);
  background: #fff;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease;
}

.alert-employee-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 28px rgba(17, 44, 50, 0.08);
}

.alert-employee-card.selected {
  border-color: rgba(31, 167, 164, 0.45);
  background: #eef8f5;
}

.alert-employee-card input {
  margin-top: 4px;
}

.alert-employee-card strong,
.alert-employee-card span {
  display: block;
}

.alert-employee-card span {
  font-size: 12px;
  color: #607076;
}

.form-note {
  margin: 0;
  font-size: 12px;
  color: #5c6d72;
}

.data-row strong {
  color: #112c32;
  font-size: 14px;
}

.data-row span {
  color: #607076;
  font-size: 11px;
}

.table-pill {
  display: inline-flex;
  width: fit-content;
  padding: 7px 12px;
  border-radius: 999px;
  background: #e9f4ee;
  color: #26553c;
  font-size: 12px;
  font-weight: 600;
}

.table-pill.accent {
  background: #e6f4f3;
  color: #0f4449;
}

.table-pill.active {
  background: #e8f5ee;
  color: #21633f;
}

.table-pill.inactive {
  background: #f4e8e8;
  color: #8a2e2e;
}

.table-pill.success {
  background: var(--bg-success);
  color: var(--text-success);
}

.table-pill.warning {
  background: var(--bg-warning);
  color: var(--text-warning);
}

.table-pill.danger {
  background: var(--bg-danger);
  color: var(--text-danger);
}

.table-pill-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  margin-right: 6px;
  background: currentColor;
  flex-shrink: 0;
}

.hero {
  padding: 32px 6vw 90px;
  position: relative;
  overflow: hidden;
  background: #f5f1e8;
}

.hero::after {
  content: "";
  position: absolute;
  inset: auto -10% -35% -10%;
  height: 320px;
  background: rgba(17, 44, 50, 0.05);
  transform: rotate(-6deg);
  z-index: 0;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  position: relative;
  z-index: 1;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: inline-block;
  position: relative;
  box-shadow: 0 8px 20px rgba(17, 44, 50, 0.16);
}

.brand-mark-logo {
  object-fit: contain;
  background: #fff;
}

.brand-name {
  font-weight: 600;
  font-size: 20px;
  letter-spacing: 0.5px;
}

.brand-tag {
  font-size: 12px;
  color: #66736c;
}

.nav-links {
  display: flex;
  gap: 20px;
  font-size: 14px;
  color: #3f4d52;
}

.nav-links a {
  position: relative;
}

.nav-links a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -4px;
  width: 0;
  height: 2px;
  background: #1fa7a4;
  transition: width 0.2s ease;
}

.nav-links a:hover::after {
  width: 100%;
}

.cta {
  background: #112c32;
  color: #f7f4ef;
  border: none;
  padding: 10px 18px;
  border-radius: 999px;
  font-weight: 600;
  cursor: pointer;
}

.ghost {
  border: 1px solid #112c32;
  background: transparent;
  color: #112c32;
  padding: 10px 18px;
  border-radius: 999px;
  font-weight: 600;
  cursor: pointer;
}

.hero-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 48px;
  margin-top: 48px;
  position: relative;
  z-index: 1;
}

.hero-copy h1 {
  font-size: clamp(32px, 4vw, 56px);
  margin: 16px 0;
  color: #112c32;
}

.lead {
  font-size: 18px;
  color: #39464b;
  max-width: 520px;
}

.eyebrow {
  text-transform: uppercase;
  font-size: 12px;
  letter-spacing: 2px;
  color: #1fa7a4;
  font-weight: 600;
}

.hero-actions {
  display: flex;
  gap: 14px;
  margin: 26px 0 24px;
  flex-wrap: wrap;
}

.hero-stats {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.hero-stats div {
  background: #fff;
  padding: 12px 18px;
  border-radius: 12px;
  box-shadow: 0 10px 20px rgba(17, 44, 50, 0.08);
}

.hero-stats span {
  font-weight: 600;
  display: block;
}

.hero-panel {
  display: grid;
  gap: 16px;
}

.panel-card {
  background: #fff;
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 18px 40px rgba(17, 44, 50, 0.12);
}

.panel-card.subtle {
  background: #f0f7f6;
  box-shadow: none;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  background: #ffad46;
  color: #3b2a08;
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 999px;
}

/* When /api/public/stats answers, the badge switches to a calm green so the
   "Live" claim is honest rather than decorative. */
.status[data-live] {
  background: #e4f7ec;
  color: #14603f;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.status[data-live]::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #1f9d6d;
  box-shadow: 0 0 0 0 rgba(31, 157, 109, 0.5);
  animation: panelPing 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

@keyframes panelPing {
  0% {
    box-shadow: 0 0 0 0 rgba(31, 157, 109, 0.45);
  }
  70% {
    box-shadow: 0 0 0 7px rgba(31, 157, 109, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(31, 157, 109, 0);
  }
}

.panel-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 20px 0;
}

.panel-row div {
  background: #f7f4ef;
  padding: 12px;
  border-radius: 12px;
}

.panel-row strong {
  display: block;
  font-size: 20px;
}

/* ── live 7-day sparkline in the overview hero panel ─────────────────────── */

.panel-spark {
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 14px;
  padding: 14px 14px 10px;
  background: linear-gradient(180deg, #fbfdfa 0%, #ffffff 100%);
}

.panel-spark-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}

.panel-spark-head p {
  margin: 0;
  font-size: 13px;
  font-weight: 600;
  color: #14382c;
}

.panel-spark-head em {
  font-style: normal;
  font-size: 12px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 999px;
  background: #e4f7ec;
  color: #14603f;
}

.panel-spark-head em[data-dir="down"] {
  background: #fdeee6;
  color: #8a4b1d;
}

.panel-spark-bars {
  margin-top: 12px;
  height: 62px;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  align-items: end;
  gap: 8px;
}

.panel-spark-bars i {
  height: var(--h, 40%);
  border-radius: 6px 6px 3px 3px;
  background: linear-gradient(180deg, #a5f0d0 0%, #d8f6a8 100%);
  transform-origin: bottom;
  animation: panelGrow 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.panel-spark-bars i.is-today {
  background: linear-gradient(180deg, #c8f45f 0%, #7fe0c8 100%);
  box-shadow: 0 6px 14px rgba(31, 157, 109, 0.22);
}

@keyframes panelGrow {
  from {
    transform: scaleY(0.05);
    opacity: 0;
  }
  to {
    transform: scaleY(1);
    opacity: 1;
  }
}

.panel-spark-days {
  margin-top: 8px;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8px;
}

.panel-spark-days small {
  text-align: center;
  font-size: 10px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #5d6f66;
}

.panel-activity {
  margin-top: 16px;
}

.panel-activity p {
  margin: 0 0 8px;
  font-size: 13px;
  font-weight: 600;
  color: #14382c;
}

@media (prefers-reduced-motion: reduce) {
  .panel-spark-bars i,
  .status[data-live]::before {
    animation: none;
  }
}

.panel-note {
  margin-top: 18px;
  padding: 10px 14px;
  background: #112c32;
  color: #f7f4ef;
  border-radius: 12px;
  font-size: 14px;
}

.section {
  padding: 72px 8vw;
}

.section.alt {
  background: #f3f0ea;
}

.section-head {
  max-width: 720px;
  margin-bottom: 32px;
}

.section-head h2 {
  font-size: clamp(26px, 3vw, 40px);
  margin: 12px 0 8px;
  color: #112c32;
}

.section-head p {
  color: #405156;
}

/* Edit and Delete Button Styles */
.action-btn {
  border: 1px solid rgba(17, 44, 50, 0.12);
  border-radius: 14px;
  background: #fff;
  color: #112c32;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease,
    background-color 0.2s ease,
    color 0.2s ease;
}

.icon-btn {
  width: 40px;
  height: 40px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.icon-btn svg {
  width: 18px;
  height: 18px;
}

.employee-row .icon-btn {
  animation: employeeActionIdle 3.2s ease-in-out infinite;
}

@keyframes employeeActionIdle {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-1px);
  }
}

.action-btn:hover {
  transform: translateY(-2px) scale(1.04);
  box-shadow: 0 12px 24px rgba(17, 44, 50, 0.12);
}

.action-btn:active {
  transform: translateY(0) scale(0.98);
}

.edit-btn {
  border-color: rgba(31, 167, 164, 0.18);
  color: #0f5c59;
  background: linear-gradient(
    180deg,
    rgba(31, 167, 164, 0.14),
    rgba(31, 167, 164, 0.04)
  );
}

.edit-btn:hover {
  background: linear-gradient(
    180deg,
    rgba(31, 167, 164, 0.24),
    rgba(31, 167, 164, 0.08)
  );
  border-color: rgba(31, 167, 164, 0.34);
  color: #0b4441;
}

.delete-btn {
  border-color: rgba(216, 78, 78, 0.22);
  color: #b43030;
  background: linear-gradient(
    180deg,
    rgba(216, 78, 78, 0.12),
    rgba(216, 78, 78, 0.03)
  );
}

.delete-btn:hover {
  background: linear-gradient(
    180deg,
    rgba(216, 78, 78, 0.22),
    rgba(216, 78, 78, 0.08)
  );
  border-color: rgba(216, 78, 78, 0.36);
  color: #912020;
}

.employee-form-panel {
  width: min(520px, 96vw);
  gap: 20px;
}

.employee-panel-head {
  position: sticky;
  top: 0;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.98),
    rgba(255, 255, 255, 0.92)
  );
  padding-bottom: 8px;
  z-index: 1;
}

.employee-panel-copy {
  margin: 8px 0 0;
  color: #607076;
  font-size: 13px;
  line-height: 1.5;
}

.employee-panel-summary {
  display: grid;
  gap: 12px;
}

.employee-form-card {
  border-radius: 24px;
  box-shadow: none;
}

.employee-form-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.employee-form-grid input,
.employee-form-grid select {
  font-family: inherit;
}

.employee-panel-actions {
  justify-content: flex-end;
}

.delete-modal-card {
  max-width: 460px;
}

.delete-modal-copy {
  margin: 0;
  color: #31454b;
  line-height: 1.6;
}

.delete-modal-summary {
  display: grid;
  gap: 4px;
  padding: 14px 16px;
  border-radius: 16px;
  background: #f8faf8;
  border: 1px solid rgba(17, 44, 50, 0.08);
}

.delete-modal-summary strong {
  color: #112c32;
}

.delete-modal-summary span {
  color: #607076;
  font-size: 13px;
}

/* Modal Styles */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 44, 50, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-card {
  background: #fff;
  border-radius: 24px;
  border: 1px solid rgba(17, 44, 50, 0.08);
  box-shadow: 0 20px 60px rgba(17, 44, 50, 0.15);
  max-width: 500px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
}

.leave-import-modal {
  max-width: 640px;
}

.leave-import-subtitle {
  display: block;
  margin-top: 5px;
  color: #607076;
  font-size: 12px;
}

.leave-import-guide {
  display: grid;
  gap: 8px;
  padding: 16px;
  border-radius: 16px;
  background: #eef7f4;
  border: 1px solid rgba(31, 167, 164, 0.16);
  color: #244047;
}

.leave-import-guide span,
.leave-import-guide small {
  line-height: 1.5;
}

.leave-import-required-grid {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.leave-import-guide code {
  padding: 2px 6px;
  border-radius: 6px;
  background: rgba(17, 44, 50, 0.08);
  font-size: 12px;
}

.leave-template-button {
  justify-self: start;
}

.leave-import-options {
  display: grid;
  grid-template-columns: minmax(180px, 1fr) repeat(2, minmax(130px, auto));
  gap: 12px;
  align-items: end;
}

.leave-import-check {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  border: 1px solid rgba(17, 44, 50, 0.12);
  border-radius: 10px;
  background: #fbfcfb;
  color: #244047;
  font-size: 13px;
  font-weight: 500;
}

.leave-import-check input {
  width: 15px;
  height: 15px;
  accent-color: #1fa7a4;
}

.leave-import-file {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 14px;
  border-radius: 12px;
  background: #f7f7f5;
  color: #506166;
  font-size: 12px;
}

.leave-import-file strong {
  color: #112c32;
  overflow-wrap: anywhere;
}

.leave-import-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.leave-import-summary span {
  display: grid;
  gap: 4px;
  padding: 12px;
  border-radius: 12px;
  background: #f3f7f5;
  color: #607076;
  font-size: 12px;
  text-align: center;
}

.leave-import-summary strong {
  color: #112c32;
  font-size: 20px;
}

.leave-import-errors {
  display: grid;
  gap: 6px;
  max-height: 140px;
  overflow-y: auto;
  padding: 12px;
  border-radius: 12px;
  background: rgba(198, 40, 40, 0.07);
  color: #9b2525;
  font-size: 12px;
}

.modal-header {
  padding: 24px;
  border-bottom: 1px solid rgba(17, 44, 50, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.modal-header strong {
  font-size: 18px;
  color: #112c32;
  margin: 0;
}

.modal-body {
  padding: 24px;
  display: grid;
  gap: 16px;
}

.form-group {
  display: grid;
  gap: 8px;
}

.form-group label,
.form-group > span {
  font-size: 13px;
  font-weight: 500;
  color: #112c32;
}

.form-group input,
.form-group select {
  padding: 12px;
  border: 1px solid rgba(17, 44, 50, 0.15);
  border-radius: 8px;
  font-size: 14px;
  color: #112c32;
  font-family:
    "Manrope",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    sans-serif;
  transition: all 0.2s ease;
}

.form-group input:focus,
.form-group select:focus {
  outline: none;
  border-color: #1fa7a4;
  box-shadow: 0 0 0 3px rgba(31, 167, 164, 0.1);
}

.form-group input:disabled {
  background: #f5f5f5;
  color: #999;
  cursor: not-allowed;
}

.form-note {
  font-size: 13px;
  color: #2e7d32;
  background: rgba(76, 175, 80, 0.1);
  border-left: 3px solid #4caf50;
  padding: 10px 12px;
  border-radius: 4px;
  margin: 0;
}

.form-note.error {
  color: #c62828;
  background: rgba(244, 67, 54, 0.1);
  border-left-color: #f44336;
}

.modal-actions {
  padding: 20px 24px;
  border-top: 1px solid rgba(17, 44, 50, 0.08);
  display: flex;
  gap: 12px;
  justify-content: flex-end;
}

.modal-actions button {
  padding: 10px 20px;
  border: 1px solid rgba(17, 44, 50, 0.2);
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  font-family:
    "Manrope",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    sans-serif;
  cursor: pointer;
  transition: all 0.2s ease;
}

.modal-actions .ghost {
  background: transparent;
  color: #112c32;
}

.modal-actions .ghost:hover:not(:disabled) {
  background: #f5f5f5;
  border-color: #112c32;
}

.modal-actions .cta {
  background: #1fa7a4;
  color: #fff;
  border-color: #1fa7a4;
}

.modal-actions .cta:hover:not(:disabled) {
  background: #0f4449;
  border-color: #0f4449;
}

.modal-actions .danger {
  background: #ba2c2c;
  color: #fff;
  border-color: #ba2c2c;
}

.modal-actions .danger:hover:not(:disabled) {
  background: #901e1e;
  border-color: #901e1e;
}

.modal-actions button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.card {
  background: #fff;
  padding: 20px;
  border-radius: 18px;
  box-shadow: 0 8px 18px rgba(17, 44, 50, 0.08);
}

.card h3 {
  margin: 0 0 8px;
  color: #112c32;
}

.features .feature {
  border-left: 4px solid #1fa7a4;
}

.timeline {
  display: grid;
  gap: 18px;
}

.timeline-step {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  background: #fff;
  padding: 18px;
  border-radius: 14px;
  box-shadow: 0 6px 16px rgba(17, 44, 50, 0.08);
}

.step-index {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: #1fa7a4;
  color: #fff;
  display: grid;
  place-items: center;
  font-weight: 600;
}

.split {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 28px;
  align-items: center;
}

.list {
  padding-left: 18px;
  margin: 18px 0 0;
}

.list li {
  margin-bottom: 10px;
}

.chip-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.chip {
  background: #e6f4f3;
  color: #0f4449;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
}

.delete-card {
  background: #fff;
  padding: 28px;
  border-radius: 20px;
  display: grid;
  gap: 16px;
  max-width: 560px;
  box-shadow: 0 12px 26px rgba(17, 44, 50, 0.1);
}

.delete-card label {
  display: block;
  font-size: 13px;
  margin-bottom: 6px;
  color: #3f4d52;
}

.delete-card input {
  width: 100%;
  padding: 12px 14px;
  border-radius: 10px;
  border: 1px solid #d8d2c9;
  font-size: 14px;
}

.delete-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.danger {
  background: #8d1b1b;
  color: #fff;
  border: none;
  padding: 10px 18px;
  border-radius: 999px;
  font-weight: 600;
  cursor: pointer;
}

.delete-note {
  font-size: 12px;
  color: #6c7a80;
}

.footer {
  padding: 32px 8vw 48px;
  background: #112c32;
  color: #f7f4ef;
  display: flex;
  justify-content: space-between;
  gap: 18px;
  flex-wrap: wrap;
}

.footer-links {
  display: flex;
  gap: 16px;
  font-size: 14px;
}

.calendar-controls {
  width: 100%;
  align-items: end;
  gap: 10px;
}

.calendar-module-tabs {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.calendar-layout {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
  gap: 10px;
  align-items: start;
  position: relative;
  overflow: visible;
  isolation: isolate;
}

.calendar-card {
  overflow: visible;
  position: relative;
  z-index: 20;
  background:
    radial-gradient(
      circle at top right,
      rgba(31, 167, 164, 0.06),
      transparent 24%
    ),
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.99),
      rgba(249, 246, 241, 0.96)
    );
  border: 1px solid rgba(16, 40, 45, 0.08);
  box-shadow: 0 14px 34px rgba(17, 44, 50, 0.06);
}

.calendar-card-head {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 6px;
  padding: 14px 14px 0;
}

.calendar-card-head-copy {
  display: grid;
  gap: 4px;
}

.calendar-kicker {
  font-size: 11px;
  font-weight: 500;
  color: #5d7b78;
}

.calendar-card-head-actions {
  display: grid;
  gap: 8px;
  justify-items: end;
}

.calendar-card-head strong {
  display: block;
  font-size: 20px;
  color: #10282d;
  line-height: 1.05;
}

.calendar-card-head span {
  color: #5f7277;
  font-size: 12px;
}

.calendar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.legend-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #4d5e63;
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid rgba(16, 40, 45, 0.12);
  border-radius: 999px;
  padding: 3px 8px;
}

.legend-item::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #c0c9cb;
}

.legend-item.attendance::before {
  background: #1fa7a4;
}

.legend-item.leave::before {
  background: #d8872d;
}

.legend-item.birthday::before {
  background: #9b59b6;
}

.legend-item.holiday::before {
  background: #d25151;
}

.legend-item.half-day::before {
  background: #c79a37;
}

.legend-item.weekend::before {
  background: #6f7f84;
}

.legend-item.today::before {
  background: #285ad9;
}

.calendar-insights {
  display: grid;
  grid-template-columns: repeat(4, minmax(104px, 1fr));
  gap: 6px;
  width: 100%;
}

.calendar-insight-card {
  padding: 8px 10px;
  border-radius: 14px;
  border: 1px solid rgba(16, 40, 45, 0.08);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8px 18px rgba(17, 44, 50, 0.04);
  display: grid;
  gap: 2px;
  min-width: 0;
}

.calendar-insight-card span {
  font-size: 11px;
  font-weight: 400;
  color: #6b7f84;
}

.calendar-insight-card strong {
  font-size: 14px;
  color: #10282d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.calendar-grid-shell {
  padding: 10px 14px 14px;
}

.admin-calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 6px;
  align-items: stretch;
  position: relative;
  overflow: visible;
  isolation: isolate;
}

.admin-calendar-grid.view-attendance .admin-calendar-day {
  --heat-rgb: 31, 167, 164;
}

.admin-calendar-grid.view-leaves .admin-calendar-day {
  --heat-rgb: 216, 135, 45;
}

.admin-calendar-grid.view-holidays .admin-calendar-day {
  --heat-rgb: 210, 81, 81;
}

.admin-calendar-grid.view-birthdays .admin-calendar-day {
  --heat-rgb: 155, 89, 182;
}

.admin-calendar-weekday {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #5a6b70;
  text-align: center;
  padding-bottom: 2px;
}

.admin-calendar-offset {
  min-height: 84px;
  border-radius: 12px;
}

.admin-calendar-day {
  --heat: 0;
  --heat-rgb: 31, 167, 164;
  position: relative;
  z-index: 1;
  min-height: 84px;
  border-radius: 12px;
  border: 1px solid rgba(16, 40, 45, 0.1);
  padding: 8px 8px 7px;
  text-align: left;
  cursor: pointer;
  overflow: visible;
  background:
    linear-gradient(
      170deg,
      rgba(255, 255, 255, 0.98),
      rgba(249, 245, 238, 0.92)
    ),
    rgba(var(--heat-rgb), calc(0.08 + (var(--heat) * 0.36)));
  box-shadow: 0 8px 18px rgba(17, 44, 50, 0.06);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.admin-calendar-day.heat-none {
  background:
    linear-gradient(
      170deg,
      rgba(255, 255, 255, 0.95),
      rgba(248, 243, 236, 0.88)
    ),
    rgba(var(--heat-rgb), 0.04);
}

.admin-calendar-day.heat-light {
  box-shadow: 0 10px 20px rgba(var(--heat-rgb), 0.14);
}

.admin-calendar-day.heat-medium {
  box-shadow: 0 12px 24px rgba(var(--heat-rgb), 0.18);
}

.admin-calendar-day.heat-strong {
  box-shadow: 0 14px 28px rgba(var(--heat-rgb), 0.24);
}

.admin-calendar-day:hover {
  transform: translateY(-2px);
  border-color: rgba(16, 40, 45, 0.26);
}

.admin-calendar-day:focus-visible {
  outline: none;
  border-color: #2c61b8;
  box-shadow: 0 0 0 3px rgba(44, 97, 184, 0.22);
}

.admin-calendar-day.holiday {
  border-color: rgba(210, 81, 81, 0.36);
}

.admin-calendar-day.sunday,
.admin-calendar-day.second-saturday,
.admin-calendar-day.fourth-saturday {
  border-style: dashed;
}

.admin-calendar-day.half-day {
  border-color: rgba(199, 154, 55, 0.34);
  background:
    linear-gradient(
      170deg,
      rgba(255, 255, 255, 0.98),
      rgba(250, 245, 233, 0.94)
    ),
    rgba(199, 154, 55, calc(0.06 + (var(--heat) * 0.18)));
}

.admin-calendar-day.today {
  border-color: rgba(40, 90, 217, 0.48);
  box-shadow:
    0 0 0 2px rgba(40, 90, 217, 0.14),
    0 12px 24px rgba(17, 44, 50, 0.12);
}

.calendar-day-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.calendar-day-number {
  font-size: 13px;
  font-weight: 600;
  color: #10282d;
}

.calendar-day-icon {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #6b7f84;
  line-height: 1;
}

.calendar-day-type {
  margin-top: 5px;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: #718287;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.calendar-day-metrics {
  margin-top: 6px;
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
}

.calendar-day-metric {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 2px 6px;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.calendar-day-metric.attendance {
  background: rgba(31, 167, 164, 0.16);
  color: #0b5a58;
}

.calendar-day-metric.leave {
  background: rgba(216, 135, 45, 0.16);
  color: #7d4b10;
}

.calendar-day-metric.birthday {
  background: rgba(155, 89, 182, 0.18);
  color: #5f2a75;
}

.calendar-day-metric.holiday {
  background: rgba(210, 81, 81, 0.16);
  color: #8f2a2a;
}

.calendar-day-metric.half-day {
  background: rgba(199, 154, 55, 0.18);
  color: #7d5c11;
}

.calendar-day-popover {
  position: absolute;
  top: calc(100% + 8px);
  left: 50%;
  transform: translateX(-50%) translateY(6px);
  min-width: 220px;
  max-width: 280px;
  background: transparent;
  color: #e9f5f3;
  border-radius: 14px;
  padding: 10px 12px;
  display: grid;
  gap: 4px;
  box-shadow: 0 20px 36px rgba(6, 17, 19, 0.38);
  pointer-events: none;
  opacity: 0;
  z-index: 120;
  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

.calendar-day-popover strong {
  font-size: 13px;
}

.calendar-day-popover span {
  font-size: 12px;
  color: rgba(233, 245, 243, 0.9);
}

.admin-calendar-day:hover .calendar-day-popover,
.admin-calendar-day:focus-visible .calendar-day-popover,
.admin-calendar-day.popover-open .calendar-day-popover {
  z-index: 120;
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.admin-calendar-day:hover,
.admin-calendar-day:focus-visible,
.admin-calendar-day.popover-open {
  z-index: 30;
}

.calendar-holiday-list-card {
  position: relative;
  z-index: 10;
  min-height: 420px;
}

.calendar-holiday-list {
  display: grid;
  gap: 8px;
  max-height: 560px;
  overflow: auto;
  padding: 0 14px 14px;
}

.calendar-holiday-list-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  border: 1px solid rgba(16, 40, 45, 0.1);
  border-radius: 14px;
  padding: 9px 10px;
  background: rgba(255, 255, 255, 0.84);
}

.calendar-holiday-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: rgba(31, 167, 164, 0.14);
  display: grid;
  place-items: center;
  font-size: 16px;
}

.calendar-holiday-icon.attendance {
  background: rgba(31, 167, 164, 0.14);
  color: #0b5a58;
  font-weight: 600;
}

.calendar-holiday-icon.leave {
  background: rgba(216, 135, 45, 0.16);
  color: #7d4b10;
  font-weight: 600;
}

.calendar-holiday-icon.birthday {
  background: rgba(155, 89, 182, 0.18);
  color: #5f2a75;
  font-weight: 600;
}

.calendar-holiday-copy {
  min-width: 0;
}

.calendar-holiday-copy strong,
.calendar-holiday-copy span,
.calendar-holiday-copy small {
  display: block;
}

.calendar-holiday-copy strong {
  color: #10282d;
  font-size: 14px;
}

.calendar-holiday-copy span {
  color: #55696e;
  font-size: 12px;
}

.calendar-holiday-copy small {
  color: #678186;
  font-size: 11px;
  margin-top: 2px;
}

.calendar-holiday-copy p {
  margin: 4px 0 0;
  color: #495d62;
  font-size: 12px;
}

.holiday-modal-card {
  max-width: 640px;
}

.holiday-form-grid {
  grid-template-columns: 1fr 1fr;
}

.holiday-description-label {
  display: block;
  font-size: 12px;
  font-weight: 500;
  color: #607277;
  margin: 12px 2px 8px;
}

.holiday-description-input {
  width: 100%;
  border-radius: 16px;
  border: 1px solid rgba(17, 44, 50, 0.14);
  background: rgba(255, 255, 255, 0.92);
  padding: 12px 14px;
  resize: vertical;
  font-family: inherit;
  color: #112c32;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.holiday-description-input:focus {
  outline: none;
  border-color: #4a8f83;
  box-shadow: 0 0 0 3px rgba(74, 143, 131, 0.16);
}

@media (max-width: 880px) {
  .nav {
    flex-direction: column;
    align-items: flex-start;
  }
  .nav-links {
    flex-wrap: wrap;
  }
  .panel-row {
    grid-template-columns: 1fr;
  }

  .policy-hero,
  .policy-content {
    padding-left: 20px;
    padding-right: 20px;
  }
}

@media (max-width: 980px) {
  .admin-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    border-right: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dashboard-main {
    padding: 20px;
  }

  .login-stage {
    padding: 0;
  }

  .login-reference-shell {
    grid-template-columns: 43% 57%;
  }

  .login-reference-story {
    padding: 46px 76px 46px 32px;
  }

  .login-reference-form-panel {
    padding: 64px 34px 64px 72px;
  }

  .dashboard-main-login {
    padding: 0;
  }

  .login-stage-topbar {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    width: 100%;
    max-width: 720px;
    flex-direction: column;
    align-items: stretch;
  }

  .login-stage-meta {
    justify-content: flex-start;
  }

  .dashboard-hero {
    grid-template-columns: 1fr;
  }

  .reports-layout {
    grid-template-columns: 1fr;
  }

  .dashboard-analytics-grid {
    grid-template-columns: 1fr;
  }

  .calendar-layout {
    grid-template-columns: 1fr;
  }

  .calendar-card-head-actions {
    justify-items: stretch;
  }

  .calendar-insights {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .calendar-holiday-list {
    max-height: none;
  }

  .field-visit-panel {
    width: 100vw;
    max-width: 100vw;
  }

  .employee-form-grid {
    grid-template-columns: 1fr;
  }

  .efficiency-row {
    grid-template-columns: 1fr;
  }

  .data-row {
    grid-template-columns: 1fr;
  }

  .dashboard-table {
    min-width: 640px;
  }

  .map-dialog {
    width: min(98vw, 760px);
    max-height: 92vh;
    border-radius: 20px;
  }

  .map-dialog-header {
    padding: 12px 16px 10px;
  }

  .map-dialog-header strong {
    font-size: clamp(24px, 7vw, 32px);
  }

  .map-dialog-body {
    padding-bottom: 4px;
  }

  .map-dialog-meta {
    padding: 12px 16px 8px;
  }

  .map-dialog-coords-row {
    grid-template-columns: 1fr;
    font-size: 15px;
  }

  .map-dialog-map {
    height: min(42vh, 340px);
  }

  .map-dialog-map.leaflet-container {
    height: min(42vh, 340px);
  }

  .map-dialog-points ol {
    font-size: 13px;
    max-height: 190px;
  }

  .map-dialog-footer {
    padding: 10px 16px 14px;
  }

  .attendance-section-head {
    align-items: stretch;
  }

  .attendance-head-actions {
    justify-content: flex-start;
    flex-basis: 100%;
  }

  .attendance-toolbar-row {
    align-items: stretch;
  }

  .attendance-controls-inline {
    justify-content: flex-start;
    gap: 12px;
  }

  .attendance-filter-search {
    max-width: none;
    flex-basis: 100%;
  }

  .attendance-filter-date {
    flex: 1 1 220px;
  }

  .employee-search-card {
    align-items: stretch;
  }

  .employee-search-shell {
    min-width: 0;
    width: 100%;
  }

  .employee-toolbar-meta {
    margin-left: 0;
  }

  .leave-filter-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .attendance-exception-filter-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .exception-card-grid {
    grid-template-columns: 1fr;
  }

  .calendar-weekdays,
  .calendar-grid-page {
    gap: 10px;
  }

  .calendar-day-card {
    min-height: 140px;
  }
}

@media (max-width: 700px) {
  .report-toolbar,
  .report-actions {
    flex-direction: column;
  }

  .calendar-weekdays {
    display: none;
  }

  .calendar-grid-page {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .employee-status-menu {
    right: auto;
    left: 0;
  }

  .leave-filter-grid {
    grid-template-columns: 1fr;
  }

  .leave-filter-actions {
    align-items: stretch;
  }

  .leave-filter-actions > span:first-child {
    width: 100%;
    margin-right: 0;
  }

  .leave-filter-actions button {
    flex: 1 1 160px;
  }

  .leave-import-summary {
    grid-template-columns: 1fr;
  }

  .leave-import-options {
    grid-template-columns: 1fr;
  }

  .line-chart {
    height: 180px;
  }

  .line-chart-labels {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .admin-calendar-grid {
    gap: 8px;
  }

  .admin-calendar-day,
  .admin-calendar-offset {
    min-height: 88px;
    border-radius: 14px;
  }

  .admin-calendar-day {
    padding: 8px;
  }

  .calendar-grid-shell {
    padding: 12px;
  }

  .calendar-day-popover {
    left: 8px;
    right: 8px;
    transform: translateY(6px);
    min-width: 0;
    max-width: none;
    z-index: 120;
  }

  .admin-calendar-day:hover .calendar-day-popover,
  .admin-calendar-day:focus-visible .calendar-day-popover,
  .admin-calendar-day.popover-open .calendar-day-popover {
    transform: translateY(0);
  }
}

/* Public product tour: an editorial walkthrough built from the same visual language as the intro. */
.tour-page {
  background: #f7f4ef;
  color: #1f2a2e;
}

.tour-hero {
  position: relative;
  overflow: hidden;
  min-height: 680px;
  background:
    radial-gradient(
      circle at 74% 16%,
      rgba(215, 154, 85, 0.18),
      transparent 22%
    ),
    radial-gradient(
      circle at 15% 70%,
      rgba(31, 167, 164, 0.12),
      transparent 28%
    ),
    linear-gradient(145deg, #f7f4ef 0%, #edf3ef 54%, #e7eee9 100%);
}

.tour-hero::after {
  content: "";
  position: absolute;
  width: 460px;
  height: 460px;
  right: -130px;
  bottom: -210px;
  border: 1px solid rgba(17, 44, 50, 0.1);
  border-radius: 50%;
  box-shadow:
    0 0 0 36px rgba(17, 44, 50, 0.025),
    0 0 0 72px rgba(17, 44, 50, 0.018);
  pointer-events: none;
}

.tour-hero-copy,
.tour-story,
.tour-page .nav {
  position: relative;
  z-index: 1;
}

.tour-hero-copy {
  width: min(760px, 84vw);
  margin: 100px auto 0;
  text-align: center;
}

.tour-hero-copy h1 {
  max-width: 760px;
  margin: 16px auto;
  color: #112c32;
  font-size: clamp(42px, 7vw, 78px);
  line-height: 1.02;
  letter-spacing: -0.04em;
}

.tour-hero-copy .lead {
  max-width: 620px;
  margin: 0 auto;
}

.tour-hero-copy .hero-actions {
  justify-content: center;
  margin-top: 30px;
}

.tour-back-link {
  display: inline-flex;
  align-items: center;
}

.tour-story {
  width: min(1180px, 88vw);
  margin: 0 auto;
}

.tour-intro {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
  padding: 92px 0 42px;
  border-bottom: 1px solid rgba(17, 44, 50, 0.1);
}

.tour-intro span {
  color: #0f5a45;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.tour-intro p {
  max-width: 420px;
  margin: 0;
  color: #536267;
  font-size: 18px;
}

.tour-step {
  display: grid;
  grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
  align-items: center;
  gap: clamp(42px, 8vw, 120px);
  min-height: 660px;
  padding: 86px 0;
}

.tour-step-reverse .tour-copy {
  order: 2;
}
.tour-step-reverse .tour-frame {
  order: 1;
}

.tour-number {
  display: block;
  margin-bottom: 24px;
  color: #d79a55;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.tour-copy h2 {
  max-width: 480px;
  margin: 10px 0 18px;
  color: #112c32;
  font-size: clamp(32px, 4vw, 54px);
  line-height: 1.08;
  letter-spacing: -0.035em;
}

.tour-copy > p:not(.eyebrow) {
  max-width: 460px;
  color: #536267;
  font-size: 16px;
  line-height: 1.75;
}

.tour-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 26px;
}

.tour-tags span {
  padding: 8px 11px;
  border: 1px solid rgba(17, 44, 50, 0.1);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.6);
  color: #315157;
  font-size: 12px;
  font-weight: 700;
}

.tour-frame {
  position: relative;
  min-width: 0;
  padding: 16px;
  border: 1px solid rgba(17, 44, 50, 0.12);
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.52);
  box-shadow:
    0 28px 60px rgba(17, 44, 50, 0.12),
    inset 0 1px rgba(255, 255, 255, 0.9);
  transform: rotate(1.2deg);
}

.tour-step-reverse .tour-frame {
  transform: rotate(-1.2deg);
}

.tour-frame-glow {
  position: absolute;
  z-index: -1;
  inset: 16% -8% -12%;
  border-radius: 50%;
  background: rgba(31, 167, 164, 0.14);
  filter: blur(34px);
}

.tour-demo {
  min-height: 350px;
  overflow: hidden;
  padding: 24px;
  border: 1px solid rgba(17, 44, 50, 0.1);
  border-radius: 18px;
  background: linear-gradient(145deg, #fbfdfb, #eef5f1);
  color: #17383e;
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.95);
}

.demo-sidebar {
  display: grid;
  justify-items: center;
  gap: 18px;
  width: 42px;
  padding: 10px 0;
  border-radius: 14px;
  background: #315247;
}
.demo-sidebar img {
  width: 25px;
  height: 25px;
  border-radius: 8px;
  object-fit: cover;
}
.demo-sidebar i,
.demo-toolbar em {
  display: block;
  width: 18px;
  height: 5px;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.42);
}
.tour-demo-overview {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 20px;
}
.demo-main {
  display: grid;
  gap: 18px;
  align-content: start;
}
.demo-line {
  width: 34%;
  height: 12px;
  border-radius: 99px;
  background: #315247;
}
.demo-line-wide {
  width: 64%;
}
.demo-kpis {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.demo-kpis b,
.demo-person,
.demo-approval,
.demo-report-foot b {
  display: grid;
  gap: 6px;
  padding: 14px;
  border: 1px solid rgba(17, 44, 50, 0.08);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.72);
}
.demo-kpis strong {
  font-size: 27px;
  color: #112c32;
}
.demo-kpis small,
.demo-person small,
.demo-approval small,
.demo-report-foot small {
  color: #748287;
  font-size: 10px;
}
.demo-chart {
  display: flex;
  align-items: end;
  gap: 9px;
  height: 130px;
  padding: 18px;
  border-radius: 14px;
  background: #e4efea;
}
.demo-chart span {
  flex: 1;
  min-height: 18px;
  border-radius: 5px 5px 2px 2px;
  background: linear-gradient(#58c6b5, #2d8e8b);
}
.demo-chart span:nth-child(2) {
  height: 54%;
}
.demo-chart span:nth-child(3) {
  height: 72%;
}
.demo-chart span:nth-child(4) {
  height: 44%;
}
.demo-chart span:nth-child(5) {
  height: 84%;
}
.demo-chart span:nth-child(6) {
  height: 64%;
}
.demo-chart span:nth-child(7) {
  height: 92%;
}
.demo-list {
  display: grid;
  gap: 8px;
}
.demo-list i {
  height: 10px;
  border-radius: 99px;
  background: #d7e5df;
}
.demo-toolbar {
  display: flex;
  gap: 10px;
  align-items: center;
  margin-bottom: 20px;
}
.demo-toolbar span {
  width: 24%;
  height: 11px;
  border-radius: 99px;
  background: #315247;
}
.demo-toolbar span:nth-child(2),
.demo-toolbar span:nth-child(3) {
  width: 15%;
  background: #c8d9d2;
}
.demo-toolbar em {
  margin-left: auto;
  background: #d79a55;
}
.demo-people-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.demo-person {
  min-height: 120px;
}
.demo-avatar,
.demo-approval > b {
  display: grid;
  place-items: center;
  width: 31px;
  height: 31px;
  border-radius: 10px;
  background: #d8eee8;
  color: #0f5a45;
  font-size: 11px;
}
.demo-avatar-1 {
  background: #f4e4cf;
  color: #9e6337;
}
.demo-avatar-2 {
  background: #e2e1f3;
  color: #5c568e;
}
.demo-person i {
  width: 30%;
  height: 5px;
  border-radius: 99px;
  background: #58c6b5;
}
.demo-table {
  display: grid;
  gap: 1px;
  border-radius: 12px;
  overflow: hidden;
  background: #dbe7e2;
}
.demo-table-head,
.demo-table-row {
  display: grid;
  grid-template-columns: 1.5fr 0.7fr 0.7fr 0.8fr;
  gap: 10px;
  align-items: center;
  padding: 13px 14px;
  background: rgba(255, 255, 255, 0.8);
}
.demo-table-head {
  background: #e2eee9;
}
.demo-table-head i {
  height: 6px;
  border-radius: 99px;
  background: #9bb4aa;
}
.demo-table-row strong {
  font-size: 11px;
}
.demo-table-row span,
.demo-table-row small {
  color: #748287;
  font-size: 10px;
}
.demo-good {
  color: #18815e !important;
}
.demo-warning {
  color: #b87021 !important;
}
.demo-approval-head,
.demo-report-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22px;
}
.demo-approval-head strong,
.demo-report-head strong {
  font-size: 16px;
}
.demo-approval-head span,
.demo-report-head span {
  color: #748287;
  font-size: 11px;
}
.demo-approval {
  grid-template-columns: 34px 1fr auto;
  align-items: center;
  margin-bottom: 10px;
}
.demo-approval button {
  border: 0;
  border-radius: 8px;
  padding: 8px 10px;
  background: #315247;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
}
.tour-demo-map {
  position: relative;
  min-height: 350px;
  background: #dfece8;
}
.demo-map-grid {
  position: absolute;
  inset: 0;
  opacity: 0.7;
  background-image:
    linear-gradient(
      32deg,
      transparent 48%,
      #bfd6ce 49%,
      #bfd6ce 51%,
      transparent 52%
    ),
    linear-gradient(
      116deg,
      transparent 47%,
      #c7dbd4 48%,
      #c7dbd4 51%,
      transparent 52%
    );
  background-size:
    90px 70px,
    130px 100px;
}
.demo-route {
  position: absolute;
  left: 20%;
  top: 31%;
  width: 62%;
  height: 35%;
  border: 4px solid #2d8e8b;
  border-left-color: transparent;
  border-bottom-color: #58c6b5;
  border-radius: 50%;
  transform: rotate(-12deg);
}
.demo-pin {
  position: absolute;
  width: 18px;
  height: 18px;
  border: 4px solid #fff;
  border-radius: 50%;
  background: #d79a55;
  box-shadow: 0 4px 10px rgba(17, 44, 50, 0.2);
}
.demo-pin-a {
  left: 17%;
  top: 30%;
}
.demo-pin-b {
  right: 17%;
  bottom: 29%;
  background: #315247;
}
.demo-map-card {
  position: absolute;
  right: 20px;
  bottom: 20px;
  display: grid;
  gap: 5px;
  width: min(220px, 60%);
  padding: 14px;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 12px 28px rgba(17, 44, 50, 0.1);
}
.demo-map-card strong {
  font-size: 13px;
}
.demo-map-card small,
.demo-map-card span {
  color: #748287;
  font-size: 10px;
}
.demo-report-chart {
  height: 165px;
  padding: 14px;
  border-radius: 14px;
  background: #e4efea;
}
.demo-report-chart svg {
  width: 100%;
  height: 100%;
}
.demo-report-chart polyline {
  fill: none;
  stroke: #2d8e8b;
  stroke-width: 5;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.demo-report-foot {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 16px;
}
.demo-report-foot strong {
  font-size: 19px;
  color: #112c32;
}
.tour-cta {
  margin: 42px 0 110px;
  padding: 72px 30px;
  border: 1px solid rgba(17, 44, 50, 0.1);
  border-radius: 28px;
  background: linear-gradient(135deg, #315247, #476c60);
  color: #fff;
  text-align: center;
  box-shadow: 0 22px 44px rgba(17, 44, 50, 0.12);
}
.tour-cta h2 {
  margin: 12px 0;
  font-size: clamp(32px, 5vw, 54px);
  letter-spacing: -0.035em;
}
.tour-cta > p:not(.eyebrow) {
  max-width: 500px;
  margin: 0 auto 26px;
  color: rgba(255, 255, 255, 0.76);
}
.tour-cta .eyebrow {
  color: #f2c58e;
}

/* Login presentation: preserve the OTP experience, but make it belong to the product. */
.fxgrid {
  opacity: 0.55;
  background-image:
    linear-gradient(rgba(var(--fa), 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--fa), 0.08) 1px, transparent 1px);
}
.fxcard {
  color: #1d2d49;
}
.fxemp {
  background: rgba(108, 141, 245, 0.055);
  border-bottom-color: rgba(var(--fa), 0.36);
  border-radius: 12px 12px 4px 4px;
}
.fxemp-in::placeholder {
  color: #98a6b9;
}
.fxotp-cell {
  border-color: rgba(var(--fa), 0.28);
  background: rgba(108, 141, 245, 0.045);
  color: #1d2d49;
  border-radius: 14px;
}
.fxback {
  background: rgba(255, 255, 255, 0.68);
  border-color: rgba(73, 101, 153, 0.16);
  color: #51678a;
}
.fxchip {
  background: rgba(255, 255, 255, 0.55);
  border-color: rgba(73, 101, 153, 0.13);
}
.fxchip strong {
  color: #1d2d49 !important;
}
.fxchip span {
  color: #72829a !important;
}
.fxchip small {
  color: #8a98aa !important;
}
.fxlabel {
  color: #526581 !important;
}
.fxbp:hover:not(:disabled) {
  box-shadow: 0 14px 34px rgba(86, 103, 209, 0.34);
}
.fxspinner {
  border-color: rgba(255, 255, 255, 0.4);
  border-top-color: #fff;
}

@media (max-width: 760px) {
  .tour-hero {
    min-height: 610px;
  }
  .tour-hero-copy {
    margin-top: 70px;
  }
  .tour-hero-copy h1 {
    font-size: clamp(38px, 12vw, 58px);
  }
  .tour-intro {
    display: grid;
    padding-top: 64px;
  }
  .tour-step,
  .tour-step-reverse {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 34px;
    min-height: auto;
    padding: 64px 0;
  }
  .tour-step-reverse .tour-copy,
  .tour-step-reverse .tour-frame {
    order: initial;
  }
  .tour-copy h2 {
    font-size: 38px;
  }
  .tour-frame,
  .tour-step-reverse .tour-frame {
    transform: none;
  }
  .tour-demo {
    min-height: 300px;
    padding: 16px;
  }
  .demo-people-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .demo-kpis {
    gap: 6px;
  }
  .demo-kpis b {
    padding: 10px;
  }
  .demo-kpis strong {
    font-size: 21px;
  }
  .demo-table-row {
    grid-template-columns: 1.4fr 0.7fr 0.7fr;
  }
  .demo-table-row small {
    display: none;
  }
  .tour-cta {
    margin-bottom: 70px;
    padding: 54px 22px;
  }
}

@media (max-width: 520px) {
  .tour-page .nav-links {
    display: none;
  }
  .tour-page .nav {
    padding-inline: 20px;
  }
  .tour-page .nav > .cta {
    padding-inline: 14px;
  }
  .fxcard {
    padding: 30px 22px 26px;
  }
  .fxchip:nth-child(2) {
    display: none;
  }
  .fxotp-cell {
    width: 42px;
    height: 48px;
  }
  .tour-demo-overview {
    gap: 10px;
  }
  .demo-sidebar {
    width: 34px;
  }
  .demo-sidebar i {
    width: 14px;
  }
  .demo-report-foot {
    gap: 5px;
  }
  .demo-report-foot b {
    padding: 9px 7px;
  }
  .demo-report-foot strong {
    font-size: 15px;
  }
}

@media (max-width: 640px) {
  .sidebar-brand {
    align-items: flex-start;
  }

  .dashboard-main-login {
    padding: 0;
  }

  .login-stage {
    padding: 0;
    align-items: start;
  }

  .login-reference-shell {
    min-height: 100vh;
    grid-template-columns: 1fr;
  }

  .login-reference-story {
    min-height: 270px;
    padding: 28px 24px;
    margin-right: 0;
    clip-path: polygon(0 0, 100% 0, 100% 86%, 0 100%);
  }

  .login-reference-message h1 {
    margin: 10px 0 18px;
    font-size: 25px;
  }

  .login-reference-chart {
    display: none;
  }

  .login-reference-disclaimer {
    margin-top: 26px;
  }

  .login-reference-form-panel {
    padding: 58px 24px 34px;
  }

  .login-reference-heading h2 {
    font-size: 26px;
  }

  .login-otp-cells {
    gap: 7px;
  }

  .dashboard-analytics-card {
    padding: 18px;
  }

  .weekly-attendance-bars {
    height: 125px;
    gap: 7px;
  }

  .weekly-attendance-metrics {
    gap: 18px;
  }

  .login-stage-back {
    top: 16px;
    right: 16px;
  }

  .modal-actions {
    flex-direction: column-reverse;
  }

  .modal-actions button {
    width: 100%;
  }

  .holiday-form-grid {
    grid-template-columns: 1fr;
  }

  .calendar-card-head {
    padding: 14px 14px 0;
  }

  .calendar-insights {
    grid-template-columns: 1fr;
  }
}

[data-animate] {
  animation: fadeIn 0.8s ease both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ── KPI Dashboard Cards ─────────────────────────────────────────────────── */
.kpi-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.kpi-card {
  background: #fff;
  border: 1px solid #eaedf4;
  border-radius: 14px;
  padding: 18px 20px;
  display: flex;
  align-items: flex-start;
  gap: 14px;
  box-shadow: 0 2px 8px rgba(15, 33, 71, 0.05);
}

.kpi-icon {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.kpi-icon svg {
  width: 20px;
  height: 20px;
}

.kpi-blue {
  background: #eef6f1;
  color: #4f806a;
}
.kpi-green {
  background: #edfaf4;
  color: #3fbe7a;
}
.kpi-orange {
  background: #fff6ec;
  color: #efa13a;
}
.kpi-purple {
  background: #f4f0ff;
  color: #7c3aed;
}

.kpi-body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.kpi-label {
  font-size: 12px;
  color: #8a93a3;
  font-weight: 500;
}

.kpi-value {
  font-size: 26px;
  font-weight: 600;
  color: #0f2147;
  line-height: 1.1;
  font-family: inherit;
}

.kpi-sub {
  font-size: 11px;
  color: #a0aabb;
  margin-top: 2px;
}

/* ── Dashboard Charts Row ────────────────────────────────────────────────── */
.dashboard-charts-row {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
  gap: 16px;
  align-items: start;
}

.chart-card {
  background: #fff;
  border: 1px solid #eaedf4;
  border-radius: 14px;
  padding: 20px 22px 16px;
  box-shadow: 0 2px 8px rgba(15, 33, 71, 0.05);
}

.chart-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16px;
}

.chart-card-head strong {
  font-size: 14px;
  font-weight: 600;
  color: #0f2147;
}

.chart-card-sub {
  font-size: 11px;
  color: #8a93a3;
}

/* ── Weekly Bar Chart ────────────────────────────────────────────────────── */
.weekly-bar-chart {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  height: 120px;
  padding-bottom: 4px;
}

.weekly-bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  flex: 1;
}

.weekly-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  background: #f4f6fb;
  border-radius: 6px 6px 0 0;
  min-height: 8px;
  overflow: hidden;
}

.weekly-bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #78aa8e 0%, #4f806a 100%);
  border-radius: 4px 4px 0 0;
  transition: height 0.3s ease;
  min-height: 4px;
}

.weekly-bar-label {
  font-size: 10px;
  color: #8a93a3;
  font-weight: 500;
}

.weekly-bar-count {
  font-size: 10px;
  color: #37414f;
  font-weight: 600;
}

/* ── Department Bars ──────────────────────────────────────────────────────── */
.dept-bars {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.dept-bar-row {
  display: grid;
  grid-template-columns: 90px 1fr 28px;
  align-items: center;
  gap: 8px;
}

.dept-bar-label {
  font-size: 12px;
  color: #37414f;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dept-bar-track {
  height: 6px;
  background: #f4f6fb;
  border-radius: 999px;
  overflow: hidden;
}

.dept-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4f806a 0%, #91b8a2 100%);
  border-radius: 999px;
  transition: width 0.3s ease;
}

.dept-bar-count {
  font-size: 12px;
  color: #8a93a3;
  font-weight: 600;
  text-align: right;
}

/* ── KPI / Charts responsive ─────────────────────────────────────────────── */
@media (max-width: 980px) {
  .kpi-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-charts-row {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .kpi-row {
    grid-template-columns: 1fr;
  }
}

/* ── Hope-inspired evergreen + lime theme ───────────────────────────── */
:root {
  --theme-evergreen: #0f4938;
  --theme-evergreen-deep: #0a3529;
  --theme-evergreen-soft: #e8f1eb;
  --theme-lime: #c8f45f;
  --theme-lime-soft: #efffc9;
  --theme-canvas: #f4f5ef;
  --theme-surface: #ffffff;
  --theme-surface-muted: #f7f8f4;
  --theme-border: #e2e6dc;
  --theme-text: #17221d;
  --theme-muted: #7b857f;

  /* Admin dashboard component tokens - alias onto the theme above, so any
     page built with these (stat cards, tables, pills, inputs) stays on-brand
     without every page hardcoding the same evergreen/lime values. */
  --surface-1: var(--theme-surface-muted);
  --surface-2: var(--theme-surface);
  --border: var(--theme-border);
  --border-strong: #c7d1c2;
  --border-accent: var(--theme-evergreen);
  --text-primary: var(--theme-text);
  --text-secondary: #55615b;
  --text-muted: var(--theme-muted);
  --bg-accent: var(--theme-evergreen-soft);
  --text-accent: var(--theme-evergreen);
  --bg-success: var(--theme-lime-soft);
  --text-success: var(--theme-evergreen-deep);
  --bg-warning: #fdf1dc;
  --text-warning: #8a5a12;
  --bg-danger: #f4e8e8;
  --text-danger: #8a2e2e;
  --radius: 10px;
}

.admin-shell:not(.admin-shell-login) {
  --theme-evergreen: #4f7bf7;
  --theme-evergreen-deep: #416ce7;
  --theme-evergreen-soft: #eef3ff;
  --theme-lime: #ffffff;
  --theme-lime-soft: #eef3ff;
  --theme-canvas: #f3f4f8;
  --theme-surface: #ffffff;
  --theme-surface-muted: #f8f9fb;
  --theme-border: #e5e7eb;
  --theme-text: #111827;
  --theme-muted: #747b84;
  --surface-1: #f8f9fb;
  --surface-2: #ffffff;
  --border: #e5e7eb;
  --border-strong: #d9dee8;
  --border-accent: #4f7bf7;
  --text-primary: #111827;
  --text-secondary: #747b84;
  --text-muted: #8b929c;
  --bg-accent: #eef3ff;
  --text-accent: #4f7bf7;
  --bg-success: #eafbea;
  --text-success: #168a41;
  --bg-warning: #fff8dc;
  --text-warning: #b98900;
  --bg-danger: #feecef;
  --text-danger: #ef4444;
  --radius: 8px;
}

body,
.admin-shell,
.dashboard-main {
  background: var(--theme-canvas);
  color: var(--theme-text);
}

.admin-shell,
.dashboard-main {
  min-width: 0;
}

.dashboard-main:not(.dashboard-main-login) {
  overflow-x: clip;
  padding: 24px 28px;
}

.sidebar {
  background: var(--theme-canvas);
  color: var(--theme-text);
  gap: 0;
  border-right: 1px solid #eaedf2;
  box-shadow: none;
  overflow: hidden;
  padding: 10px 6px;
}

.sidebar-panel {
  min-height: 0;
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  gap: 0;
  width: 100%;
  overflow: hidden;
  border: 0.5px solid var(--border);
  border-radius: 12px;
  background: var(--surface-2);
}

.sidebar-panel-head {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 16px;
  border-bottom: 0.5px solid var(--border);
}

.sidebar-panel-close,
.sidebar-mobile-bar,
.sidebar-mobile-scrim {
  display: none;
}

.sidebar-brand {
  flex: 1 1 auto;
  min-width: 0;
  gap: 10px;
  padding: 0;
  border-bottom: 0;
}

.sidebar-logo {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: var(--bg-accent);
  color: var(--text-accent);
  box-shadow: none;
  font-size: 13px;
  font-weight: 500;
}

.sidebar .sidebar-brand-text {
  display: grid;
  align-items: initial;
  gap: 1px;
  min-width: 0;
}

.sidebar .brand-name {
  overflow: hidden;
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar .brand-subtitle {
  overflow: hidden;
  color: var(--text-secondary);
  font-size: 12px;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-brand-selector,
.sidebar-subgroup-plus,
.sidebar-search-icon {
  display: inline-grid;
  place-items: center;
  flex-shrink: 0;
  color: var(--text-muted);
}

.sidebar-brand-selector,
.sidebar-brand-selector svg {
  width: 16px;
  height: 16px;
}

.sidebar-subgroup-plus,
.sidebar-subgroup-plus svg {
  width: 13px;
  height: 13px;
}

.sidebar-search {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 34px;
  margin: 12px 12px 4px;
  padding: 0 10px;
  border: 0.5px solid var(--border);
  border-radius: var(--radius);
  color: var(--text-muted);
  font-size: 13px;
}

.sidebar-search-icon,
.sidebar-search-icon svg {
  width: 15px;
  height: 15px;
}

.sidebar-search-placeholder {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-search kbd {
  display: inline-flex;
  align-items: center;
  height: 20px;
  padding: 0 5px;
  border: 0.5px solid var(--border);
  border-radius: 4px;
  color: var(--text-muted);
  background: #ffffff;
  font-family: inherit;
  font-size: 11px;
  font-weight: 500;
}

.sidebar-org-selector {
  display: none;
}

.sidebar-nav {
  display: grid;
  flex: 1 1 auto;
  align-content: start;
  gap: 0;
  min-height: 0;
  overflow-y: auto;
  padding: 0 12px 10px;
}

.sidebar-nav::-webkit-scrollbar {
  width: 6px;
}

.sidebar-nav::-webkit-scrollbar-thumb {
  background: #d9dee8;
  border-radius: 999px;
}

.sidebar-section {
  display: grid;
  gap: 0;
}

.sidebar-section + .sidebar-section {
  margin-top: 8px;
}

.sidebar-section--primary {
  padding: 6px 0 2px;
}

.sidebar-section-label {
  padding: 10px 4px 4px;
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.04em;
  line-height: 1.1;
  text-transform: uppercase;
}

.sidebar-subgroup-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 24px;
  margin: 6px 0 2px;
  padding: 0 4px 0 10px;
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.04em;
  line-height: 1.1;
  text-transform: uppercase;
}

.sidebar-group {
  display: grid;
  flex: initial;
  overflow: visible;
  gap: 2px;
  padding-right: 0;
}

.sidebar-link {
  width: 100%;
  height: 32px;
  min-height: 32px;
  padding: 0 10px;
  border: 0;
  border-radius: var(--radius);
  background: transparent;
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.2;
}

.sidebar-link--nested {
  padding-left: 22px;
}

.sidebar-link-main {
  flex: 1 1 auto;
  gap: 10px;
}

.sidebar-link-label {
  overflow: hidden;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-link:hover {
  transform: none;
  background: #f8f9fb;
  color: #111827;
}

.sidebar-link.active {
  background: #eef3ff;
  color: #4f7bf7;
  font-weight: 500;
  box-shadow: none;
}

.sidebar-link-icon {
  width: 16px;
  height: 16px;
  border-radius: 0;
  background: transparent;
  color: currentColor;
}

.sidebar-link-icon svg {
  width: 16px;
  height: 16px;
}

.sidebar-link.active .sidebar-link-icon {
  background: transparent;
  color: currentColor;
}

.sidebar-link-badge,
.sidebar-link.active .sidebar-link-badge {
  background: #eef3ff;
  color: #4f7bf7;
}

.sidebar-support {
  display: grid;
  gap: 2px;
  padding: 8px 12px;
  border-top: 0.5px solid var(--border);
}

.sidebar-link--utility {
  color: var(--text-secondary);
}

.sidebar-foot {
  flex-direction: row;
  align-items: center;
  gap: 10px;
  margin-top: 0;
  padding: 10px 14px;
  border-top: 0.5px solid var(--border);
}

.sidebar-profile-info strong {
  color: var(--text-primary);
  font-size: 13px;
  font-weight: 500;
}

.sidebar-profile-info span {
  color: var(--text-secondary);
  font-size: 11px;
}

.sidebar-profile {
  flex: 1 1 auto;
  padding: 0;
}

.sidebar-avatar {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #eef3ff;
  color: #4f7bf7;
  font-size: 12px;
  font-weight: 500;
  box-shadow: none;
}

.sidebar-profile-menu {
  display: inline-grid;
  place-items: center;
  flex: 0 0 auto;
  width: 28px;
  height: 28px;
  padding: 0;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition:
    background 0.15s ease,
    color 0.15s ease;
}

.sidebar-profile-menu svg {
  width: 14px;
  height: 14px;
}

.sidebar-profile-menu:hover {
  background: #f8f9fb;
  color: var(--text-primary);
}

.sidebar-note {
  background: var(--theme-surface-muted);
  color: var(--theme-text);
}

.sidebar-note span {
  color: var(--theme-muted);
}

.sidebar-back {
  border-color: #bfc9c1;
  color: var(--theme-evergreen);
}

@media (max-width: 980px) {
  .sidebar {
    position: sticky;
    top: 0;
    z-index: 40;
    min-height: auto;
    padding: 0;
    border-right: none;
    border-bottom: 1px solid #eaedf2;
    overflow: visible;
  }

  .sidebar-mobile-bar {
    height: 64px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 40px;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    background: #ffffff;
  }

  .sidebar-mobile-brand {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 10px;
  }

  .sidebar-mobile-brand .brand-name {
    font-size: 16px;
  }

  .sidebar-mobile-active {
    min-width: 0;
    display: grid;
    justify-items: end;
    gap: 1px;
    text-align: right;
  }

  .sidebar-mobile-active span {
    color: #8b929c;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .sidebar-mobile-active strong {
    max-width: 150px;
    overflow: hidden;
    color: #111827;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-mobile-toggle,
  .sidebar-panel-close {
    width: 38px;
    height: 38px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #ffffff;
    color: #747b84;
    cursor: pointer;
  }

  .sidebar-mobile-toggle:hover,
  .sidebar-panel-close:hover {
    border-color: #d9dee8;
    background: #f8f9fb;
    color: #111827;
  }

  .sidebar-mobile-toggle svg,
  .sidebar-panel-close svg {
    width: 19px;
    height: 19px;
  }

  .sidebar-panel {
    position: fixed;
    z-index: 43;
    inset: 0 auto 0 0;
    width: min(318px, calc(100vw - 48px));
    max-width: 100%;
    padding: 0;
    border: 0.5px solid var(--border);
    border-left: 0;
    border-radius: 0 12px 12px 0;
    background: var(--surface-2);
    box-shadow: 24px 0 48px rgba(17, 24, 39, 0.14);
    overflow-y: auto;
    transform: translateX(-105%);
    transition: transform 0.22s ease;
  }

  .sidebar--mobile-open .sidebar-panel {
    transform: translateX(0);
  }

  .sidebar-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 12px 14px 16px;
  }

  .sidebar-panel-head .sidebar-brand {
    min-width: 0;
    padding: 0;
  }

  .sidebar-mobile-scrim {
    position: fixed;
    z-index: 42;
    inset: 0;
    border: 0;
    background: rgba(17, 24, 39, 0.28);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .sidebar--mobile-open .sidebar-mobile-scrim {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar-group {
    grid-template-columns: minmax(0, 1fr);
    overflow: visible;
  }
}

.dashboard-highlight,
.dashboard-analytics-card,
.chart-card,
.calendar-card,
.data-card,
.form-card,
.report-actions-card,
.alert-side-card,
.kpi-card {
  background: var(--theme-surface);
  border-color: var(--theme-border);
  box-shadow: 0 8px 24px rgba(25, 50, 39, 0.055);
}

.dashboard-hero h1,
.dashboard-highlight strong,
.dashboard-section-head h2,
.chart-card-head strong,
.dashboard-analytics-head strong,
.weekly-attendance-metrics strong,
.kpi-value {
  color: var(--theme-text);
}

.dashboard-copy,
.dashboard-highlight p,
.dashboard-highlight span,
.dashboard-analytics-head span,
.weekly-attendance-metrics span {
  color: var(--theme-muted);
}

.dashboard-user-avatar {
  background: var(--theme-evergreen);
  color: var(--theme-lime);
}

.dashboard-user-card {
  color: var(--theme-text);
}

.dashboard-user-card:hover {
  background: var(--theme-evergreen-soft);
}

.refresh-toast,
.table-pill.accent,
.table-pill.active {
  background: var(--theme-lime-soft);
  color: var(--theme-evergreen-deep);
}

.cta,
.dashboard-button.cta,
.login-reference-submit {
  background: var(--theme-evergreen);
  color: #fff;
  box-shadow: 0 10px 20px rgba(15, 73, 56, 0.2);
}

.cta:hover,
.dashboard-button.cta:hover,
.login-reference-submit:hover:not(:disabled) {
  background: var(--theme-evergreen-deep);
}

.ghost,
.dashboard-button.ghost {
  border-color: #b8c5bd;
  color: var(--theme-evergreen);
  background: #fff;
}

.ghost:hover,
.dashboard-button.ghost:hover {
  border-color: var(--theme-evergreen);
  background: var(--theme-evergreen-soft);
}

input:focus,
select:focus,
textarea:focus,
.modern-date-input:focus,
.login-reference-form > input:focus,
.login-otp-cells input:focus {
  border-color: var(--theme-evergreen) !important;
  box-shadow: 0 0 0 3px rgba(15, 73, 56, 0.12) !important;
}

.attendance-tab.active {
  background: var(--theme-evergreen);
  border-color: var(--theme-evergreen);
  color: #fff;
}

.attendance-tab.active span {
  background: var(--theme-lime);
  color: var(--theme-evergreen-deep);
}

.weekly-attendance-bar,
.weekly-bar-fill {
  background: linear-gradient(180deg, #3f856e, var(--theme-evergreen));
}

.weekly-attendance-bar.current {
  background: linear-gradient(180deg, var(--theme-lime), #8fcf42);
}

.department-attendance-track div,
.dept-bar-fill,
.efficiency-bar-fill {
  background: linear-gradient(90deg, var(--theme-evergreen), #5d9d7e);
}

.kpi-blue {
  background: var(--theme-evergreen-soft);
  color: var(--theme-evergreen);
}

.login-stage,
.login-reference-form-panel,
.login-reference-shell {
  background: #fafaff;
}

.login-reference-story {
  background:
    radial-gradient(
      circle at 90% 62%,
      rgba(108, 82, 237, 0.32),
      transparent 27%
    ),
    linear-gradient(145deg, #282247, #17142f);
}

.login-reference-story::after {
  background: rgba(100, 76, 240, 0.14);
}

.login-reference-message > span {
  color: #a9a0ff;
}

.login-chart-head strong {
  color: #91ebd0;
}

.login-chart-bars i {
  background: linear-gradient(180deg, #806cff, #5545a8);
}

.login-resend {
  color: #7264cf;
}

.login-resend:hover:not(:disabled) {
  color: #4e3cd5;
}

.login-reference-submit {
  background: linear-gradient(135deg, #6750ed, #5740df);
  box-shadow: 0 12px 25px rgba(91, 68, 224, 0.28);
}

.login-reference-submit:hover:not(:disabled) {
  background: linear-gradient(135deg, #5c45e5, #4933ce);
  box-shadow: 0 15px 30px rgba(91, 68, 224, 0.34);
}

.login-reference-form > input:focus,
.login-otp-cells input:focus {
  border-color: #634cf3 !important;
  box-shadow: 0 0 0 3px rgba(99, 76, 243, 0.14) !important;
}

.nav-links a::after {
  background: var(--theme-lime);
}

/* ── Dashboard visual depth ──────────────────────────────────────────── */
.dashboard-main:not(.dashboard-main-login) {
  background: var(--theme-canvas);
}

.dashboard-hero {
  position: relative;
  overflow: visible;
  padding: 8px 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.dashboard-hero::after {
  content: none;
}

.dashboard-hero .eyebrow {
  color: #358065;
}

.dashboard-hero h1 {
  color: var(--theme-text);
}

.dashboard-hero .dashboard-copy {
  color: var(--theme-muted);
}

.dashboard-hero .dashboard-user-card {
  padding: 9px 12px;
  color: var(--theme-text);
  background: #fff;
  border: 1px solid var(--theme-border);
  box-shadow: 0 8px 20px rgba(15, 73, 56, 0.08);
}

.dashboard-hero .dashboard-user-card:hover {
  background: #f8fbf6;
  border-color: #cdd9cf;
}

.dashboard-hero .dashboard-user-avatar {
  background: var(--theme-lime);
  color: var(--theme-evergreen-deep);
}

.dashboard-hero .dashboard-user-card span,
.dashboard-hero .dashboard-user-card small,
.dashboard-hero .dashboard-user-chevron {
  color: var(--theme-muted) !important;
}

.dashboard-hero .dashboard-user-card strong {
  color: var(--theme-text);
}

.employee-overview-hero {
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 24px;
  align-items: start;
}

.employee-overview-content {
  min-width: 0;
}

.employee-overview-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.employee-overview-heading h1 {
  margin: 5px 0 0;
  font-size: clamp(25px, 2.4vw, 36px);
}

.employee-overview-grid {
  display: block;
}

.employee-overview-kpis {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 220px));
  gap: 12px;
}

.employee-overview-kpi,
.department-treemap-card {
  border: 1px solid var(--theme-border);
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 10px 24px rgba(15, 73, 56, 0.07);
}

.employee-overview-kpi {
  min-height: 112px;
  padding: 18px 20px;
  display: grid;
  align-content: center;
  gap: 3px;
  background:
    radial-gradient(
      circle at top right,
      rgba(200, 244, 95, 0.22),
      transparent 38%
    ),
    #fff;
}

.employee-overview-kpi.accent {
  background:
    radial-gradient(
      circle at top right,
      rgba(90, 157, 126, 0.2),
      transparent 40%
    ),
    #f8fbf7;
}

.employee-overview-kpi span {
  color: var(--theme-muted);
  font-size: 12px;
  font-weight: 400;
}

.employee-overview-kpi strong {
  color: var(--theme-evergreen);
  font-size: 38px;
  line-height: 1.1;
}

.employee-overview-kpi small {
  color: #839087;
  font-size: 11px;
}

.department-treemap-card {
  min-width: 0;
  padding: 18px;
}

.department-treemap-head {
  margin-bottom: 12px;
}

.department-treemap-head strong,
.department-treemap-head span {
  display: block;
}

.department-treemap-head strong {
  color: var(--theme-text);
  font-size: 14px;
}

.department-treemap-head span {
  margin-top: 3px;
  color: var(--theme-muted);
  font-size: 11px;
}

.department-treemap {
  min-height: 208px;
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.department-treemap-item {
  min-width: 105px;
  min-height: 86px;
  padding: 13px;
  display: grid;
  align-content: end;
  border-radius: 12px;
  color: #fff;
  background: #0f4938;
}

.department-treemap-item:nth-child(4n + 2) {
  background: #38775f;
}

.department-treemap-item:nth-child(4n + 3) {
  background: #76a58b;
  color: #102c24;
}

.department-treemap-item:nth-child(4n + 4) {
  background: #c8f45f;
  color: #173122;
}

.department-treemap-item span {
  overflow: hidden;
  font-size: 11px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.department-treemap-item strong {
  margin-top: 4px;
  font-size: 25px;
  line-height: 1;
}

.department-treemap-item small {
  margin-top: 3px;
  font-size: 10px;
  opacity: 0.75;
}

.dashboard-highlight {
  background:
    radial-gradient(
      circle at top right,
      rgba(200, 244, 95, 0.28),
      transparent 34%
    ),
    #fff;
  border: 1px solid rgba(200, 244, 95, 0.48);
  box-shadow: 0 14px 30px rgba(5, 35, 25, 0.18);
}

.dashboard-highlight strong {
  color: var(--theme-evergreen);
}

.dashboard-section-head {
  position: relative;
  z-index: 1;
}

.dashboard-section-head .eyebrow {
  color: #358065;
}

.report-toolbar {
  padding: 14px 16px;
  border: 1px solid #e1e8df;
  border-radius: 16px;
  background: rgba(247, 250, 245, 0.9);
}

.dashboard-analytics-card {
  background:
    radial-gradient(
      circle at top right,
      rgba(200, 244, 95, 0.12),
      transparent 27%
    ),
    #fff;
  border-color: #dce5da;
  box-shadow: 0 10px 24px rgba(15, 73, 56, 0.07);
}

.weekly-attendance-bar-shell {
  border-radius: 8px 8px 0 0;
  background: linear-gradient(
    180deg,
    rgba(232, 241, 235, 0),
    rgba(232, 241, 235, 0.7)
  );
}

.department-attendance-track {
  background: #e8eee8;
}

@media (max-width: 980px) {
  .dashboard-hero {
    padding: 26px;
  }

  .dashboard-profile-menu {
    justify-self: start;
  }

  .employee-overview-hero {
    grid-template-columns: 1fr;
  }

  .employee-overview-kpis {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .dashboard-hero {
    padding: 22px;
    border-radius: 22px;
  }

  .dashboard-hero h1 {
    font-size: 30px;
  }

  .employee-overview-kpis {
    grid-template-columns: 1fr;
  }

  .department-treemap-item {
    flex-basis: calc(50% - 7px) !important;
  }

  .attendance-exception-filter-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

/* ── Landing page layout refinement ─────────────────────────────────── */
.page {
  background: #f7f8f4;
}

.page .hero {
  padding: 22px max(24px, 2.5vw) 76px;
  background:
    radial-gradient(
      circle at 88% 18%,
      rgba(200, 244, 95, 0.2),
      transparent 23%
    ),
    linear-gradient(180deg, #fbfcf7 0%, #f2f5ed 100%);
}

.page .hero::after {
  inset: auto -5% -230px 40%;
  height: 360px;
  border-radius: 50% 0 0 0;
  background: rgba(15, 73, 56, 0.045);
  transform: rotate(-4deg);
}

.page .nav,
.page .hero-grid,
.page .section > * {
  width: min(1440px, 100%);
}

.page .nav,
.page .hero-grid {
  margin-left: auto;
  margin-right: auto;
}

.page .nav {
  min-height: 58px;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(15, 73, 56, 0.09);
}

.page .brand-mark {
  width: 46px;
  height: 46px;
  border-radius: 13px;
  box-shadow: 0 8px 20px rgba(15, 73, 56, 0.12);
}

.page .brand-name {
  font-size: 18px;
  color: #13251e;
}

.page .brand-tag {
  margin-top: 1px;
  font-size: 11px;
}

.page .nav-links {
  gap: 28px;
  color: #536159;
  font-size: 13px;
  font-weight: 600;
}

.page .nav > .cta {
  min-height: 42px;
  padding: 0 20px;
}

.page .hero-grid {
  grid-template-columns: minmax(0, 1fr) minmax(520px, 1fr);
  align-items: center;
  gap: clamp(44px, 5vw, 78px);
  margin-top: 64px;
}

.page .hero-copy {
  max-width: 680px;
}

.page .hero-copy h1 {
  max-width: 680px;
  margin: 18px 0 20px;
  font-size: clamp(42px, 4.25vw, 64px);
  line-height: 1.08;
  letter-spacing: -0.045em;
  color: #102c24;
}

.page .lead {
  max-width: 610px;
  margin: 0;
  color: #5a6861;
  font-size: 16px;
  line-height: 1.75;
}

.page .eyebrow {
  color: #2f8063;
  font-size: 11px;
  letter-spacing: 0.16em;
}

.page .hero-actions {
  margin: 30px 0 28px;
}

.page .hero-actions button {
  min-height: 46px;
  padding: 0 22px;
}

.page .hero-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.page .hero-stats div {
  min-height: 78px;
  padding: 15px 16px;
  border: 1px solid #e0e7de;
  box-shadow: 0 8px 22px rgba(15, 73, 56, 0.06);
}

.page .hero-stats span {
  color: #173c30;
  font-size: 17px;
}

.page .hero-stats small {
  color: #748079;
  line-height: 1.35;
}

.page .hero-panel {
  gap: 14px;
}

.page .panel-card {
  border: 1px solid #e0e7de;
  border-radius: 22px;
  padding: 26px;
  box-shadow: 0 16px 38px rgba(15, 73, 56, 0.08);
}

.page .panel-card.subtle {
  padding: 22px 26px;
  border-color: #dce8df;
  background:
    radial-gradient(
      circle at top right,
      rgba(200, 244, 95, 0.24),
      transparent 35%
    ),
    #edf5ef;
}

.page .panel-header h3,
.page .panel-card h4 {
  margin: 0;
  color: #17342a;
}

.page .panel-row {
  gap: 10px;
  margin: 22px 0;
}

.page .panel-row div {
  min-height: 78px;
  padding: 16px;
  background: #f5f7f2;
}

.page .panel-row strong {
  color: #123629;
  font-size: 22px;
}

.page .panel-note {
  background: #103f31;
}

.page .section {
  padding: 88px max(24px, 2.5vw);
}

.page .section > * {
  margin-left: auto;
  margin-right: auto;
}

.page .section.alt {
  background: #eef2eb;
}

.page .section-head {
  max-width: none;
  width: min(1440px, 100%);
  margin-bottom: 38px;
}

.page .section-head h2 {
  max-width: 760px;
  margin: 14px 0 10px;
  color: #17342a;
  font-size: clamp(32px, 3.2vw, 46px);
  letter-spacing: -0.035em;
}

.page .section-head p {
  max-width: 760px;
  margin: 0;
  color: #69766f;
  font-size: 16px;
}

.page .grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.page .features {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.page .card {
  min-height: 178px;
  padding: 26px;
  border: 1px solid #e0e7de;
  border-radius: 18px;
  box-shadow: 0 10px 26px rgba(15, 73, 56, 0.055);
}

.page .card h3 {
  color: #173b2f;
  font-size: 19px;
}

.page .card p {
  color: #6b7871;
  line-height: 1.65;
}

.page .features .feature {
  border-left: 0;
  border-top: 4px solid #74a88b;
}

.page .timeline {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.page .timeline-step {
  min-height: 190px;
  padding: 24px;
  flex-direction: column;
  border: 1px solid #e0e7de;
  border-radius: 18px;
  box-shadow: 0 10px 26px rgba(15, 73, 56, 0.055);
}

.page .step-index {
  background: #164f3d;
  color: #d8ff79;
}

.page .split {
  grid-template-columns: minmax(0, 0.9fr) minmax(380px, 1.1fr);
  gap: 70px;
}

.page .delete-card {
  max-width: 720px;
  grid-template-columns: 1fr 1fr;
  padding: 30px;
  border: 1px solid #e0e7de;
  box-shadow: 0 12px 28px rgba(15, 73, 56, 0.07);
}

.page .delete-actions,
.page .delete-note {
  grid-column: 1 / -1;
}

.page .footer {
  padding: 42px max(24px, 2.5vw);
  background: #103b2f;
}

@media (max-width: 980px) {
  .page .hero-grid {
    grid-template-columns: 1fr;
  }

  .page .hero-copy {
    max-width: 700px;
  }

  .page .grid,
  .page .features,
  .page .timeline {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .page .split {
    grid-template-columns: 1fr;
    gap: 36px;
  }
}

@media (max-width: 700px) {
  .page .hero {
    padding: 16px 18px 54px;
  }

  .page .nav {
    align-items: center;
  }

  .page .nav-links {
    width: 100%;
    gap: 16px;
    overflow-x: auto;
    padding: 4px 0;
  }

  .page .hero-grid {
    margin-top: 42px;
    gap: 38px;
  }

  .page .hero-copy h1 {
    font-size: 40px;
  }

  .page .hero-stats,
  .page .grid,
  .page .features,
  .page .timeline,
  .page .delete-card {
    grid-template-columns: 1fr;
  }

  .page .panel-row {
    grid-template-columns: 1fr;
  }

  .page .section {
    padding: 64px 18px;
  }
}

/* ── Compact profile menu ────────────────────────────────────────────── */
.dashboard-profile-trigger-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.dashboard-theme-icon {
  color: #4f806a;
  font-size: 18px;
  line-height: 1;
}

.dashboard-hero .dashboard-user-card {
  min-width: 0;
  padding: 5px 7px;
  gap: 8px;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.dashboard-hero .dashboard-user-card:hover {
  background: var(--theme-evergreen-soft);
}

.dashboard-hero .dashboard-user-avatar {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  border-radius: 50%;
  background: var(--theme-evergreen);
  color: #fff;
  font-size: 11px;
}

.dashboard-hero .dashboard-user-card > strong {
  max-width: 150px;
  color: var(--theme-evergreen-deep);
  font-size: 13px;
}

.dashboard-hero .dashboard-user-chevron {
  color: #5d7b6e !important;
  font-size: 15px !important;
}

.dashboard-profile-dropdown {
  top: calc(100% + 6px);
  width: 238px;
  padding: 0;
  overflow: hidden;
  border: 1px solid #d3dfd5;
  border-radius: 5px;
  box-shadow: 0 4px 12px rgba(15, 73, 56, 0.18);
}

.dashboard-profile-summary {
  display: grid;
  gap: 2px;
  padding: 11px 13px 9px;
  border-bottom: 1px solid #e1e8e2;
}

.dashboard-profile-summary strong {
  color: var(--theme-evergreen-deep);
  font-size: 13px;
}

.dashboard-profile-summary span {
  overflow: hidden;
  color: #718078;
  font-size: 11px;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dashboard-profile-dropdown .dashboard-profile-action {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px 13px;
  border-radius: 0;
  color: #46546d;
  font-size: 13px;
  font-weight: 500;
}

.dashboard-profile-dropdown .dashboard-profile-action span {
  width: 16px;
  color: #667791;
  text-align: center;
}

.dashboard-profile-dropdown .dashboard-profile-action:hover {
  background: #f2f5f9;
}

.dashboard-profile-dropdown .dashboard-profile-action.logout {
  border-top: 1px solid #e5e9f0;
  color: #e13445;
}

.dashboard-profile-dropdown .dashboard-profile-action.logout span {
  color: #e13445;
}

.dashboard-profile-dropdown .dashboard-profile-action.logout:hover {
  background: #fff2f3;
}

/* ── Calendar interaction consistency ───────────────────────────────── */
.admin-calendar-day {
  transform: none;
  transform-origin: center;
  transition:
    background-color 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease;
}

.admin-calendar-day:hover,
.admin-calendar-day:focus-visible,
.admin-calendar-day.popover-open {
  transform: none;
  z-index: 40;
  border-color: rgba(15, 73, 56, 0.42);
  box-shadow:
    0 0 0 2px rgba(15, 73, 56, 0.1),
    0 12px 26px rgba(15, 73, 56, 0.14);
}

.admin-calendar-day:focus-visible {
  outline: none;
}

.calendar-day-popover {
  top: calc(100% + 7px);
  min-width: 225px;
  padding: 12px 14px;
  border: 1px solid rgba(200, 244, 95, 0.2);
  border-radius: 12px;
  background: #103f31;
  color: #f5fbf7;
  box-shadow: 0 16px 32px rgba(8, 37, 28, 0.28);
  transform: translateX(-50%) translateY(4px);
  transition:
    opacity 0.16s ease,
    transform 0.16s ease;
}

.calendar-day-popover strong {
  color: #d9ff7d;
}

.calendar-day-popover span {
  color: rgba(245, 251, 247, 0.82);
}

.admin-calendar-day:nth-last-child(-n + 14) .calendar-day-popover {
  top: auto;
  bottom: calc(100% + 7px);
  transform: translateX(-50%) translateY(-4px);
}

.admin-calendar-day:nth-last-child(-n + 14):hover .calendar-day-popover,
.admin-calendar-day:nth-last-child(-n + 14):focus-visible .calendar-day-popover,
.admin-calendar-day:nth-last-child(-n + 14).popover-open .calendar-day-popover {
  transform: translateX(-50%) translateY(0);
}

@media (hover: none) {
  .admin-calendar-day:hover .calendar-day-popover {
    opacity: 0;
    pointer-events: none;
  }

  .admin-calendar-day.popover-open .calendar-day-popover {
    opacity: 1;
  }
}

@media (max-width: 700px) {
  .calendar-day-popover,
  .admin-calendar-day:nth-last-child(-n + 14) .calendar-day-popover {
    top: calc(100% + 7px);
    bottom: auto;
    left: 4px;
    right: 4px;
    transform: translateY(4px);
  }

  .admin-calendar-day:hover .calendar-day-popover,
  .admin-calendar-day:focus-visible .calendar-day-popover,
  .admin-calendar-day.popover-open .calendar-day-popover,
  .admin-calendar-day:nth-last-child(-n + 14):hover .calendar-day-popover,
  .admin-calendar-day:nth-last-child(-n + 14):focus-visible
    .calendar-day-popover,
  .admin-calendar-day:nth-last-child(-n + 14).popover-open
    .calendar-day-popover {
    transform: translateY(0);
  }
}

.overview-shell {
  display: grid;
  gap: 1.25rem;
}

.overview-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.9rem 0 0.1rem;
}

.overview-search {
  position: relative;
  flex: 1;
  max-width: 420px;
}

.overview-search-icon {
  position: absolute;
  top: 50%;
  left: 13px;
  transform: translateY(-50%);
  color: #aab2ac;
  font-size: 14px;
  pointer-events: none;
}

.overview-search input {
  width: 100%;
  min-height: 42px;
  padding: 0.65rem 0.95rem 0.65rem 2.2rem;
  border: 1px solid #e4e8e4;
  border-radius: 10px;
  background: #fff;
  color: #15211c;
  font: inherit;
  font-size: 0.85rem;
  outline: none;
  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.overview-search input:focus {
  border-color: #1f9d62;
  box-shadow: 0 0 0 3px #e3f4ea;
}

.overview-toolbar-status {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.overview-toolbar-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  min-height: 42px;
  padding: 0.55rem 0.85rem;
  border: 1px solid #e4e8e4;
  border-radius: 10px;
  background: #fff;
  color: #15211c;
  font-size: 0.8rem;
}

.overview-toolbar-chip strong {
  font-family:
    ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;
  font-size: 0.88rem;
  letter-spacing: 0.03em;
}

.overview-toolbar-chip span:last-child {
  color: #8a958f;
}

.overview-toolbar-chip.muted {
  color: #7f8a84;
}

.overview-toolbar-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #1f9d62;
  box-shadow: 0 0 0 4px rgba(31, 157, 98, 0.12);
}

.overview-toolbar-sync {
  color: #8fa099;
  font-size: 0.92rem;
}

.overview-topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.overview-topbar-copy {
  min-width: 0;
}

.overview-greeting {
  display: inline-flex;
  align-items: center;
  padding: 0.32rem 0.72rem;
  border-radius: 999px;
  background: #e8f5ec;
  color: #15724d;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.overview-headline {
  margin: 0.8rem 0 0.45rem;
  color: #13241d;
  font-size: clamp(1.6rem, 2vw, 2.3rem);
  line-height: 1.12;
}

.overview-headline-sub {
  margin: 0;
  color: #6b7670;
  font-size: 0.95rem;
  line-height: 1.55;
  max-width: 720px;
}

.overview-topbar-meta {
  margin: 0.5rem 0 0;
  max-width: 760px;
  color: #70817a;
  font-size: 0.9rem;
}

.overview-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  margin-top: 0.85rem;
}

.overview-meta-chip {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  padding: 0.32rem 0.78rem;
  border: 1px solid #dfe7e1;
  border-radius: 999px;
  background: #ffffff;
  color: #5d7067;
  font-size: 0.8rem;
  font-weight: 600;
}

.overview-grid-label {
  color: #8a9890;
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.overview-kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.overview-kpi-card {
  position: relative;
  background: linear-gradient(180deg, #ffffff, #f4f7f4);
  border: 1px solid #e5ece7;
  border-radius: 1.35rem;
  padding: 1.15rem 1.15rem 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.42rem;
  box-shadow: 0 14px 40px rgba(21, 33, 28, 0.06);
  overflow: hidden;
}

.overview-kpi-card.emphasis-green {
  background: #ffffff;
  border-color: #e5ece7;
  color: #13241d;
}

.overview-kpi-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 0.3rem;
}

.overview-kpi-card.emphasis-red {
  background: linear-gradient(160deg, #ffffff, #fff2f2);
  border-color: #f2d6d6;
}

.overview-kpi-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, #1f9d62, #34c77f);
}

.overview-kpi-accent.blue {
  background: linear-gradient(90deg, #2563eb, #60a5fa);
}

.overview-kpi-accent.amber {
  background: linear-gradient(90deg, #d38b1f, #efb14b);
}

.overview-kpi-accent.red {
  background: linear-gradient(90deg, #dc2626, #f87171);
}

.overview-kpi-title {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  min-width: 0;
}

.overview-kpi-icon {
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  font-size: 0.78rem;
  font-weight: 800;
  background: #e3f4ea;
  color: #15724d;
}

.overview-kpi-icon.blue {
  background: #eef2ff;
  color: #2563eb;
}

.overview-kpi-icon.amber {
  background: #fdf3e3;
  color: #b8730a;
}

.overview-kpi-icon.red {
  background: #fdeaea;
  color: #dc2626;
}

.overview-kpi-label {
  display: block;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #7e8f87;
  font-weight: 700;
}

.overview-kpi-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 0.28rem 0.62rem;
  background: #edf2ee;
  color: #4d6259;
  font-size: 0.74rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.overview-kpi-card.emphasis-green .overview-kpi-label,
.overview-kpi-card.emphasis-green .overview-kpi-tag,
.overview-kpi-card.emphasis-green .overview-kpi-meta,
.overview-kpi-card.emphasis-green .overview-kpi-value {
  color: inherit;
}

.overview-kpi-value {
  font-size: 2.2rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1;
  color: #13241d;
}

.overview-kpi-meta {
  color: #6e7c75;
  font-size: 0.9rem;
}

.overview-summary-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.8fr) minmax(280px, 0.95fr);
  gap: 1rem;
  margin-bottom: 1rem;
}

.overview-chart-card {
  padding-bottom: 1.2rem;
  border-radius: 16px;
}

.weekly-bar-chart-overview {
  min-height: 250px;
  align-items: end;
}

.overview-weekly-bar-fill {
  background: linear-gradient(180deg, #3bc882, #15724d);
}

.overview-insight-stack {
  display: grid;
  gap: 0.85rem;
}

.overview-insight-card {
  background: #ffffff;
  border: 1px solid #e5ece7;
  border-radius: 16px;
  padding: 1rem 1.1rem;
  box-shadow: 0 10px 28px rgba(21, 33, 28, 0.05);
}

.overview-insight-label {
  display: block;
  color: #73847c;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.45rem;
}

.overview-insight-card strong {
  display: block;
  font-size: 1.8rem;
  color: #112c32;
}

.overview-insight-card small {
  display: block;
  margin-top: 0.35rem;
  color: #768881;
}

.overview-detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.95fr);
  gap: 1rem;
}

.overview-card-meta {
  font-size: 0.75rem;
  color: #8b9790;
  font-weight: 600;
}

.overview-dept-bars {
  padding-top: 0.35rem;
}

.pending-approvals-card {
  padding: 0;
  overflow: hidden;
  border-radius: 16px;
}

.pending-approvals-toggle {
  width: 100%;
  border: none;
  background: linear-gradient(135deg, #f9fbf9, #eef4f0);
  padding: 1rem 1.1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  text-align: left;
  cursor: pointer;
}

.pending-approvals-toggle strong {
  display: block;
  color: #162720;
  font-size: 1rem;
}

.pending-approvals-toggle span {
  color: #6f817a;
  font-size: 0.88rem;
}

.pending-approvals-pill {
  white-space: nowrap;
  background: #ffffff;
  border: 1px solid #dde7e1;
  border-radius: 999px;
  padding: 0.4rem 0.75rem;
  color: #1b6b48;
  font-weight: 700;
}

.pending-approvals-list {
  padding: 1rem 1.1rem 1.1rem;
  display: grid;
  gap: 0.8rem;
}

.pending-approval-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  border: 1px solid #e6ede8;
  border-radius: 1rem;
  padding: 0.85rem 0.95rem;
  background: #ffffff;
}

.pending-approval-row.detailed {
  align-items: flex-start;
}

.pending-approval-copy {
  min-width: 0;
  display: grid;
  gap: 0.18rem;
}

.pending-approval-copy strong {
  color: #162720;
}

.pending-approval-copy span,
.pending-approval-copy small {
  color: #6f817a;
}

.pending-approval-meta {
  display: grid;
  justify-items: end;
  gap: 0.45rem;
  color: #6f817a;
  font-size: 0.85rem;
}

.leave-pending-card {
  margin-bottom: 1rem;
}

.compact-action-button {
  padding: 0.45rem 0.7rem;
  min-height: auto;
}

@media (max-width: 1180px) {
  .overview-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .overview-search {
    max-width: none;
  }

  .overview-toolbar-status {
    justify-content: flex-start;
  }

  .overview-topbar {
    flex-direction: column;
  }

  .overview-kpi-grid,
  .overview-summary-grid,
  .overview-detail-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .overview-topbar {
    gap: 0.85rem;
  }

  .overview-toolbar-status {
    flex-direction: column;
    align-items: stretch;
  }

  .overview-toolbar-chip {
    width: 100%;
    justify-content: flex-start;
  }

  .overview-meta-row {
    margin-top: 0.75rem;
  }

  .overview-kpi-grid,
  .overview-summary-grid,
  .overview-detail-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .pending-approval-row,
  .pending-approval-row.detailed {
    flex-direction: column;
    align-items: stretch;
  }

  .pending-approval-meta {
    justify-items: start;
  }
}

/* Admin secondary pages aligned to Today's Activity */
.admin-aligned-page,
.adm-page.admin-aligned-page,
.ops-cal.admin-aligned-page {
  display: flex;
  flex-direction: column;
  gap: 20px;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--text-primary);
  font-family: inherit;
}

.dashboard-main > .admin-aligned-page,
.admin-aligned-page > * {
  min-width: 0;
  max-width: 100%;
}

.admin-aligned-page .dashboard-section-head,
.admin-aligned-page .adm-header,
.admin-aligned-page .ops-cal-head {
  margin: 0;
  align-items: flex-start;
  gap: 12px;
}

.admin-aligned-page .dashboard-section-head > div:first-child,
.admin-aligned-page .adm-header__title {
  min-width: 0;
}

.admin-aligned-page .dashboard-section-head h2,
.admin-aligned-page .adm-heading,
.admin-aligned-page .ops-cal-title {
  margin: 0;
  color: var(--text-primary);
  font-family: inherit;
  font-size: 22px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 0;
}

.admin-aligned-page .eyebrow,
.admin-aligned-page .adm-eyebrow,
.admin-aligned-page .ops-cal-eyebrow {
  margin: 0 0 2px;
  color: var(--text-muted);
  font-family: inherit;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.admin-aligned-page .exception-head-copy,
.admin-aligned-page .ops-cal-copy {
  max-width: 680px;
  margin: 6px 0 0;
  color: var(--text-secondary);
  font-size: 13px;
  line-height: 1.45;
}

.admin-aligned-page .employee-actions,
.admin-aligned-page .adm-header__actions,
.admin-aligned-page .attendance-controls-row,
.admin-aligned-page .calendar-head-actions,
.admin-aligned-page .report-actions,
.admin-aligned-page .ops-cal-nav,
.admin-aligned-page .api-telemetry-tabs {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
}

.admin-aligned-page .dashboard-button,
.admin-aligned-page .ghost,
.admin-aligned-page .cta,
.admin-aligned-page .adm-btn,
.admin-aligned-page .adm-action-btn,
.admin-aligned-page .adm-split-btn__select,
.admin-aligned-page .adm-split-btn__action,
.admin-aligned-page .ops-cal-nav-btn,
.admin-aligned-page .ops-cal-nav-today {
  min-height: 34px;
  border-radius: var(--radius);
  font-size: 13px;
  line-height: 1;
  box-shadow: none;
}

.admin-aligned-page .adm-btn,
.admin-aligned-page .adm-action-btn,
.admin-aligned-page .ops-cal-nav-btn,
.admin-aligned-page .ops-cal-nav-today {
  border: 0.5px solid var(--border-strong);
  background: transparent;
  color: var(--text-secondary);
}

.admin-aligned-page .adm-btn:hover,
.admin-aligned-page .adm-action-btn:hover,
.admin-aligned-page .ops-cal-nav-btn:hover,
.admin-aligned-page .ops-cal-nav-today:hover {
  border-color: var(--border-strong);
  background: var(--surface-1);
  color: var(--text-primary);
}

.admin-aligned-page .adm-btn--icon,
.admin-aligned-page .ops-cal-nav-btn {
  width: 34px;
  height: 34px;
  padding: 0;
  justify-content: center;
}

.admin-aligned-page .adm-split-btn {
  height: 34px;
  border-color: var(--border-strong);
  border-radius: var(--radius);
}

.admin-aligned-page .adm-split-btn__select,
.admin-aligned-page .adm-split-btn__action {
  height: 34px;
  border-radius: 0;
}

.admin-aligned-page .table-card,
.admin-aligned-page .adm-table-card,
.admin-aligned-page .leave-filter-card,
.admin-aligned-page .adm-search-card,
.admin-aligned-page .report-toolbar,
.admin-aligned-page .report-actions-card,
.admin-aligned-page .chart-card,
.admin-aligned-page .ops-cal-panel,
.admin-aligned-page .pending-approvals-card {
  border: 0.5px solid var(--border);
  border-radius: 10px;
  background: var(--surface-2);
  box-shadow: none;
}

.admin-aligned-page .table-card,
.admin-aligned-page .adm-table-card,
.admin-aligned-page .ops-cal-panel {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.admin-aligned-page .table-scroll,
.admin-aligned-page .adm-table-scroll {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}

.admin-aligned-page .leave-filter-card,
.admin-aligned-page .adm-search-card,
.admin-aligned-page .report-toolbar,
.admin-aligned-page .report-actions-card,
.admin-aligned-page .chart-card {
  margin: 0;
  padding: 14px 16px;
}

.admin-aligned-page .report-actions-card {
  gap: 12px;
}

.admin-aligned-page .report-actions-card > div:first-child {
  display: grid;
  gap: 4px;
  min-width: 0;
}

.admin-aligned-page .kpi-cards,
.admin-aligned-page .adm-metrics,
.admin-aligned-page .ops-cal-metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin: 0;
}

.admin-aligned-page--calendar .ops-cal-metrics {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.admin-aligned-page .kpi-card,
.admin-aligned-page .adm-metric-card,
.admin-aligned-page .adm-birthday-card,
.admin-aligned-page .ops-metric {
  min-height: 72px;
  padding: 14px 16px;
  border: 0.5px solid var(--border);
  border-radius: 10px;
  background: var(--surface-2);
  box-shadow: none;
  transform: none;
}

.admin-aligned-page .admin-kpi-card-static {
  cursor: default;
}

.admin-aligned-page button.adm-metric-card:hover,
.admin-aligned-page button.adm-metric-card:focus-visible,
.admin-aligned-page .adm-metric-card--selected,
.admin-aligned-page .adm-birthday-card:hover,
.admin-aligned-page .adm-birthday-card:focus-visible,
.admin-aligned-page .adm-birthday-card--selected {
  border-color: var(--border-strong);
  background: var(--surface-1);
  box-shadow: none;
  transform: none;
}

.admin-aligned-page .adm-metric-card__label,
.admin-aligned-page .adm-birthday-card span,
.admin-aligned-page .ops-metric-label {
  margin: 0;
  color: var(--text-secondary);
  font-family: inherit;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0;
  text-transform: none;
}

.admin-aligned-page .adm-metric-card__value,
.admin-aligned-page .adm-birthday-card strong,
.admin-aligned-page .ops-metric-value,
.admin-aligned-page .kpi-count {
  margin: 0;
  color: var(--text-primary);
  font-family: inherit;
  font-size: 22px;
  font-weight: 500;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.admin-aligned-page .adm-metric-card__value--success,
.admin-aligned-page .adm-metric-card__value--muted {
  color: var(--text-primary);
}

.admin-aligned-page .adm-birthday-card small,
.admin-aligned-page .ops-metric-caption,
.admin-aligned-page .kpi-label {
  color: var(--text-secondary);
  font-size: 12px;
}

.admin-aligned-page .leave-filter-head {
  gap: 12px;
}

.admin-aligned-page .leave-filter-head strong,
.admin-aligned-page .chart-card-head strong,
.admin-aligned-page .report-actions-card strong,
.admin-aligned-page .pending-approvals-toggle strong,
.admin-aligned-page .ops-cal-panel-title {
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 600;
}

.admin-aligned-page .leave-filter-head div > span,
.admin-aligned-page .chart-card-head span,
.admin-aligned-page .report-actions-card span,
.admin-aligned-page .pending-approvals-toggle span {
  color: var(--text-secondary);
  font-size: 12px;
}

.admin-aligned-page .leave-filter-count,
.admin-aligned-page .pending-approvals-pill {
  padding: 5px 10px;
  border: 0.5px solid var(--border);
  border-radius: 13px;
  background: var(--surface-1);
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 500;
}

.admin-aligned-page .leave-filter-grid,
.admin-aligned-page .attendance-exception-filter-grid {
  gap: 10px;
}

.admin-aligned-page .attendance-exception-filter-grid {
  grid-template-columns: minmax(220px, 1.5fr) repeat(4, minmax(140px, 0.75fr));
}

.admin-aligned-page .leave-filter-field {
  gap: 5px;
}

.admin-aligned-page .leave-filter-field > span,
.admin-aligned-page .attendance-filter label,
.admin-aligned-page .attendance-filter > span {
  padding-left: 0;
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 500;
}

.admin-aligned-page .leave-filter-field input,
.admin-aligned-page .attendance-filter input,
.admin-aligned-page .attendance-filter select,
.admin-aligned-page .attendance-input-shell,
.admin-aligned-page .adm-search-wrap__input,
.admin-aligned-page .modern-date-input {
  width: 100%;
  height: 34px;
  min-height: 34px;
  padding: 0 10px;
  border: 0.5px solid var(--border-strong);
  border-radius: var(--radius);
  background: var(--surface-2);
  color: var(--text-primary);
  box-shadow: none;
  transform: none;
}

.admin-aligned-page .attendance-input-shell {
  display: flex;
  align-items: center;
  padding: 0 10px;
}

.admin-aligned-page .attendance-input-shell input {
  height: 32px;
  min-height: 0;
  padding: 0;
  border: 0;
}

.admin-aligned-page .leave-filter-field input:hover,
.admin-aligned-page .attendance-filter input:hover,
.admin-aligned-page .attendance-filter select:hover,
.admin-aligned-page .attendance-input-shell:hover,
.admin-aligned-page .adm-search-wrap__input:hover {
  border-color: var(--border-accent);
  box-shadow: none;
  transform: none;
}

.admin-aligned-page .leave-filter-field input:focus,
.admin-aligned-page .attendance-filter input:focus,
.admin-aligned-page .attendance-filter select:focus,
.admin-aligned-page .attendance-input-shell:focus-within,
.admin-aligned-page .adm-search-wrap__input:focus {
  outline: none;
  border-color: var(--border-accent);
  box-shadow: 0 0 0 2px var(--bg-accent);
  transform: none;
}

.admin-aligned-page .leave-filter-actions {
  gap: 8px;
}

.admin-aligned-page .dashboard-table,
.admin-aligned-page .adm-table {
  width: 100%;
  min-width: 760px;
  border-collapse: separate;
  border-spacing: 0;
  table-layout: fixed;
}

.admin-aligned-page .field-visit-table {
  min-width: 1320px;
}

.admin-aligned-page .attendance-exception-table {
  min-width: 1180px;
}

.admin-aligned-page--api-telemetry .dashboard-table {
  min-width: 1040px;
}

.admin-aligned-page .dashboard-table thead th,
.admin-aligned-page .adm-table th {
  padding: 12px 14px;
  border-bottom: 0.5px solid var(--border);
  background: var(--surface-1);
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.admin-aligned-page .dashboard-table tbody td,
.admin-aligned-page .adm-table td {
  padding: 14px;
  border-bottom: 0.5px solid var(--border);
  color: var(--text-primary);
  font-size: 13px;
  line-height: 1.45;
  vertical-align: top;
}

.admin-aligned-page .dashboard-table tbody tr:last-child td,
.admin-aligned-page .adm-table tbody tr:last-child td {
  border-bottom: none;
}

.admin-aligned-page .dashboard-table strong,
.admin-aligned-page .adm-table strong,
.admin-aligned-page .adm-employee-cell__name,
.admin-aligned-page .adm-cell-primary {
  color: var(--text-primary);
  font-size: 13px;
  font-weight: 600;
}

.admin-aligned-page .table-meta,
.admin-aligned-page .adm-code,
.admin-aligned-page .adm-cell-meta,
.admin-aligned-page .adm-cell-secondary {
  color: var(--text-secondary);
  font-size: 12px;
  line-height: 1.35;
}

.admin-aligned-page .adm-cell-email {
  color: var(--text-accent);
  font-size: 12px;
}

.admin-aligned-page .table-pill,
.admin-aligned-page .adm-pill {
  min-height: 24px;
  padding: 3px 9px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.2;
}

.admin-aligned-page .empty-state,
.admin-aligned-page .adm-empty {
  margin: 0;
  padding: 48px 24px;
  color: var(--text-muted);
  font-size: 14px;
}

.admin-aligned-page .map-button {
  width: 32px;
  height: 32px;
  border: 0.5px solid var(--border-strong);
  border-radius: 8px;
  background: var(--surface-1);
  color: var(--text-accent);
}

.admin-aligned-page .pending-approvals-card {
  padding: 0;
}

.admin-aligned-page .pending-approvals-toggle {
  background: var(--surface-2);
  padding: 14px 16px;
}

.admin-aligned-page .pending-approvals-list {
  padding: 14px 16px 16px;
  gap: 10px;
}

.admin-aligned-page .pending-approval-row {
  border-radius: 8px;
  border-color: var(--border);
  background: var(--surface-2);
}

.admin-aligned-page .report-toolbar {
  justify-content: flex-end;
}

.admin-aligned-page .attendance-filter-date,
.admin-aligned-page .attendance-filter-search,
.admin-aligned-page .attendance-filter-compact {
  min-width: 0;
}

.admin-aligned-page .attendance-filter-date {
  flex-basis: 178px;
}

.admin-aligned-page .attendance-filter-search {
  max-width: none;
}

.admin-aligned-page .line-chart {
  height: 180px;
}

.admin-aligned-page .efficiency-row {
  gap: 12px;
}

.admin-aligned-page.ops-cal .ops-cal-nav {
  border: 0;
  padding: 0;
  background: transparent;
}

.admin-aligned-page .ops-cal-panel {
  padding: 16px;
  overflow-x: auto;
}

.admin-aligned-page .ops-cal-panel-head {
  margin-bottom: 12px;
}

.admin-aligned-page .ops-cal-legend {
  gap: 12px;
  color: var(--text-secondary);
  font-size: 12px;
}

.admin-aligned-page .ops-cal-weekdays,
.admin-aligned-page .ops-cal-grid {
  min-width: 760px;
}

.admin-aligned-page .ops-cal-weekdays {
  padding: 0 0 8px;
  color: var(--text-muted);
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.06em;
}

.admin-aligned-page .ops-cal-grid {
  gap: 6px;
}

.admin-aligned-page .ops-day {
  min-height: 92px;
  aspect-ratio: auto;
  padding: 8px;
  border: 0.5px solid var(--border);
  border-radius: 8px;
  background: var(--surface-2);
  color: var(--text-primary);
  box-shadow: none;
  transform: none;
}

.admin-aligned-page .ops-day:hover {
  border-color: var(--border-accent);
  background: var(--surface-1);
  transform: none;
}

.admin-aligned-page .ops-day-today {
  border-color: var(--border-accent);
  box-shadow: inset 0 0 0 1px var(--border-accent);
}

.admin-aligned-page .ops-day-number {
  font-family: inherit;
  font-size: 13px;
}

.admin-aligned-page .ops-day-badge {
  border-radius: 6px;
  background: var(--bg-accent);
  color: var(--text-accent);
  font-family: inherit;
  font-size: 10px;
}

.admin-aligned-page .ops-day-stats {
  color: var(--text-secondary);
  font-family: inherit;
  font-size: 11px;
}

.admin-aligned-page .admin-kpi-card-static:hover {
  border-color: var(--border);
  background: var(--surface-2);
}

@media (max-width: 1180px) {
  .admin-aligned-page .attendance-exception-filter-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 980px) {
  .admin-aligned-page .kpi-cards,
  .admin-aligned-page .adm-metrics,
  .admin-aligned-page .ops-cal-metrics,
  .admin-aligned-page--calendar .ops-cal-metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-aligned-page .attendance-exception-filter-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .admin-aligned-page {
    gap: 16px;
  }

  .admin-aligned-page .dashboard-section-head,
  .admin-aligned-page .adm-header,
  .admin-aligned-page .ops-cal-head {
    align-items: stretch;
  }

  .admin-aligned-page .employee-actions,
  .admin-aligned-page .adm-header__actions,
  .admin-aligned-page .attendance-controls-row,
  .admin-aligned-page .calendar-head-actions,
  .admin-aligned-page .report-actions,
  .admin-aligned-page .ops-cal-nav,
  .admin-aligned-page .api-telemetry-tabs {
    justify-content: flex-start;
  }

  .admin-aligned-page .kpi-cards,
  .admin-aligned-page .adm-metrics,
  .admin-aligned-page .ops-cal-metrics,
  .admin-aligned-page--calendar .ops-cal-metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .admin-aligned-page .leave-filter-grid,
  .admin-aligned-page .attendance-exception-filter-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .admin-aligned-page .leave-filter-actions {
    align-items: stretch;
  }
}

/* Product tour showcase */
.tour-nav {
  position: relative;
  z-index: 3;
  width: min(1220px, 88vw);
  margin: auto;
  padding: 24px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.tour-brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  color: #112c32;
}
.tour-brand img {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  object-fit: cover;
  box-shadow: 0 8px 18px rgba(17, 44, 50, 0.14);
}
.tour-brand span {
  display: grid;
  gap: 1px;
}
.tour-brand strong {
  font-size: 17px;
}
.tour-brand small {
  color: #718084;
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.tour-nav-center {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #315157;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
}
.tour-nav-center i {
  width: 90px;
  height: 1px;
  background: linear-gradient(90deg, #315247, #d79a55);
}
.tour-nav-center small {
  margin-left: 5px;
  color: #849196;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0;
}
.tour-nav-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}
.tour-nav-actions > a {
  color: #526267;
  font-size: 13px;
  font-weight: 700;
}
.tour-nav-enter {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  border: 1px solid rgba(17, 44, 50, 0.16);
  border-radius: 999px;
  padding: 10px 14px 10px 17px;
  background: rgba(255, 255, 255, 0.56);
  color: #17383e;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}
.tour-nav-enter b {
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #315247;
  color: #fff;
}
.tour-hero-orbit {
  position: absolute;
  right: 5%;
  bottom: -170px;
  width: 440px;
  height: 440px;
  border: 1px solid rgba(17, 44, 50, 0.12);
  border-radius: 50%;
  box-shadow:
    0 0 0 32px rgba(17, 44, 50, 0.025),
    0 0 0 74px rgba(17, 44, 50, 0.018);
}
.tour-hero-orbit span {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #d79a55;
}
.tour-hero-orbit span:first-child {
  left: 11%;
  top: 31%;
}
.tour-hero-orbit span:nth-child(2) {
  right: 22%;
  top: 6%;
  background: #2d8e8b;
}
.tour-hero-orbit span:nth-child(3) {
  right: 3%;
  bottom: 32%;
  background: #315247;
}
.tour-chapters {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
  padding: 22px 0 0;
  border-top: 1px solid rgba(17, 44, 50, 0.1);
}
.tour-chapters button {
  position: relative;
  display: grid;
  gap: 8px;
  border: 0;
  border-bottom: 1px solid rgba(17, 44, 50, 0.14);
  padding: 12px 10px 17px;
  background: transparent;
  color: #7c8a88;
  text-align: left;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}
.tour-chapters button span {
  color: #d79a55;
  font-size: 10px;
  letter-spacing: 0.1em;
}
.tour-chapters button i {
  position: absolute;
  right: 10px;
  bottom: -1px;
  left: 10px;
  height: 2px;
  background: transparent;
}
.tour-chapters button.active {
  color: #315157;
}
.tour-chapters button.active i {
  background: #315247;
}
.tour-feature {
  display: grid;
  grid-template-columns: minmax(280px, 0.65fr) minmax(0, 1.35fr);
  align-items: center;
  gap: clamp(45px, 7vw, 105px);
  min-height: 700px;
  padding: 76px 0 96px;
}
.tour-feature-copy h2 {
  max-width: 480px;
  margin: 10px 0 18px;
  color: #112c32;
  font-size: clamp(38px, 5vw, 65px);
  line-height: 1.02;
  letter-spacing: -0.045em;
}
.tour-feature-copy > p:not(.eyebrow) {
  max-width: 460px;
  color: #536267;
  font-size: 17px;
  line-height: 1.75;
}
.tour-feature-controls {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 42px;
}
.tour-arrow {
  width: 40px;
  height: 40px;
  border: 1px solid rgba(17, 44, 50, 0.14);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.65);
  color: #315247;
  font-size: 19px;
  cursor: pointer;
}
.tour-arrow:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}
.tour-feature-controls small {
  margin-left: 10px;
  color: #879397;
  font-size: 11px;
  letter-spacing: 0.1em;
}
.tour-feature-visual {
  position: relative;
  min-width: 0;
  padding: 14px;
  border: 1px solid rgba(17, 44, 50, 0.13);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.48);
  box-shadow:
    0 30px 70px rgba(17, 44, 50, 0.14),
    inset 0 1px rgba(255, 255, 255, 0.95);
  transform: rotate(1deg);
}
.tour-window {
  position: relative;
  overflow: hidden;
  min-height: 420px;
  border: 1px solid rgba(17, 44, 50, 0.1);
  border-radius: 15px;
  background: #f8fbf9;
  box-shadow: 0 18px 45px rgba(17, 44, 50, 0.1);
}
.tour-window-bar {
  display: grid;
  grid-template-columns: 50px 1fr 50px;
  align-items: center;
  height: 36px;
  padding: 0 14px;
  border-bottom: 1px solid rgba(17, 44, 50, 0.08);
  background: rgba(255, 255, 255, 0.78);
  color: #849196;
}
.tour-window-bar small {
  text-align: center;
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.tour-window-bar > b {
  justify-self: end;
  letter-spacing: 2px;
  font-size: 10px;
}
.window-dots {
  display: flex;
  gap: 4px;
}
.window-dots i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #d79a55;
}
.window-dots i:nth-child(2) {
  background: #58c6b5;
}
.window-dots i:nth-child(3) {
  background: #b8c8c3;
}
.demo-overview {
  display: grid;
  grid-template-columns: 52px 1fr;
  min-height: 384px;
}
.demo-rail {
  display: grid;
  justify-items: center;
  align-content: start;
  gap: 17px;
  padding: 16px 0;
  background: #315247;
}
.demo-rail img {
  width: 27px;
  height: 27px;
  border-radius: 9px;
  object-fit: cover;
}
.demo-rail span,
.demo-rail em {
  width: 20px;
  height: 20px;
  border-radius: 7px;
  background: rgba(255, 255, 255, 0.13);
}
.demo-rail .rail-active {
  background: #d79a55;
}
.demo-rail em {
  margin-top: auto;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
}
.demo-work,
.demo-window-content {
  padding: 22px;
}
.demo-heading {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 12px;
}
.demo-heading small {
  display: block;
  margin-bottom: 5px;
  color: #86958f;
  font-size: 9px;
}
.demo-heading strong {
  display: block;
  color: #17383e;
  font-size: 19px;
}
.demo-heading button {
  border: 1px solid #d6e4df;
  border-radius: 7px;
  padding: 7px 9px;
  background: #fff;
  color: #52716a;
  font-size: 9px;
}
.demo-stat-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
  margin: 22px 0 14px;
}
.demo-stat-row > div {
  display: grid;
  gap: 6px;
  padding: 13px;
  border: 1px solid #e0ebe6;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.74);
}
.demo-stat-row small {
  color: #84958e;
  font-size: 9px;
}
.demo-stat-row strong {
  color: #17383e;
  font-size: 22px;
}
.demo-stat-row sup {
  color: #9aa9a3;
  font-size: 9px;
}
.demo-stat-row em {
  width: fit-content;
  padding: 3px 6px;
  border-radius: 5px;
  background: #dff1e9;
  color: #18815e;
  font-size: 8px;
  font-style: normal;
}
.demo-stat-row em.soft {
  background: #e1eef5;
  color: #337695;
}
.demo-stat-row em.warm {
  background: #f7ead9;
  color: #a96f28;
}
.demo-overview-lower {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr;
  gap: 10px;
}
.demo-panel {
  min-height: 188px;
  padding: 14px;
  border: 1px solid #e0ebe6;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.7);
}
.demo-panel header {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}
.demo-panel header strong {
  font-size: 11px;
}
.demo-panel header small {
  color: #93a19d;
  font-size: 8px;
}
.demo-panel header b {
  color: #2d8e8b;
}
.bars {
  display: flex;
  align-items: end;
  gap: 7px;
  height: 105px;
  padding-top: 20px;
}
.bars span {
  position: relative;
  display: flex;
  flex: 1;
  align-items: start;
  justify-content: center;
  min-height: 18px;
  border-radius: 4px 4px 2px 2px;
  background: linear-gradient(#58c6b5, #2d8e8b);
}
.bars span i {
  position: absolute;
  top: -14px;
  color: #6c817a;
  font-size: 7px;
  font-style: normal;
}
.demo-panel footer {
  display: flex;
  justify-content: space-between;
  color: #9aa8a3;
  font-size: 7px;
}
.demo-alerts {
  display: grid;
  align-content: start;
  gap: 11px;
}
.demo-alerts p {
  display: grid;
  grid-template-columns: 7px 1fr;
  gap: 4px 7px;
  margin: 0;
}
.demo-alerts p i {
  grid-row: span 2;
  width: 7px;
  height: 7px;
  margin-top: 3px;
  border-radius: 50%;
}
.signal-red {
  background: #d97668;
}
.signal-blue {
  background: #5c9ee8;
}
.signal-amber {
  background: #d79a55;
}
.demo-alerts p b {
  font-size: 9px;
}
.demo-alerts p span {
  color: #93a19d;
  font-size: 8px;
}
.demo-heading-line {
  align-items: center;
}
.demo-filter-row,
.demo-attendance-kpis {
  display: flex;
  gap: 8px;
  margin: 20px 0 15px;
}
.demo-filter-row > * {
  flex: 1;
  padding: 9px;
  border: 1px solid #dce8e3;
  border-radius: 7px;
  background: #fff;
  color: #84958f;
  font-size: 8px;
}
.demo-filter-row b {
  font-weight: 500;
}
.demo-primary {
  border: 0 !important;
  background: #315247 !important;
  color: #fff !important;
}
.demo-people-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}
.demo-person-card {
  display: grid;
  grid-template-columns: 28px 1fr 12px;
  gap: 8px;
  align-items: center;
  padding: 11px;
  border: 1px solid #e0ebe6;
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.72);
}
.demo-person-card > div {
  display: grid;
  gap: 3px;
  min-width: 0;
}
.demo-person-card strong {
  overflow: hidden;
  color: #315157;
  font-size: 9px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.demo-person-card small {
  color: #84958f;
  font-size: 7px;
}
.demo-person-card > i {
  color: #a1afa9;
  font-size: 8px;
}
.demo-avatar,
.approval-item > b {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: #d8eee8;
  color: #0f5a45;
  font-size: 9px;
}
.demo-avatar-1 {
  background: #f4e4cf;
  color: #9e6337;
}
.demo-avatar-2 {
  background: #e2e1f3;
  color: #5c568e;
}
.person-active {
  grid-column: 2/4;
  width: fit-content;
  padding: 3px 5px;
  border-radius: 4px;
  background: #e0f2e9;
  color: #18815e;
  font-size: 7px;
}
.demo-attendance-kpis span {
  display: grid;
  gap: 3px;
  flex: 1;
  padding: 10px;
  border: 1px solid #e0ebe6;
  border-radius: 8px;
  color: #84958f;
  font-size: 8px;
}
.demo-attendance-kpis b {
  color: #315157;
  font-size: 15px;
}
.demo-table {
  overflow: hidden;
  border: 1px solid #dfeae5;
  border-radius: 9px;
}
.demo-table-head,
.demo-table-row {
  display: grid;
  grid-template-columns: 1.5fr 0.65fr 0.65fr 0.6fr;
  gap: 8px;
  align-items: center;
  padding: 10px 12px;
}
.demo-table-head {
  background: #e7f0ec;
}
.demo-table-head i {
  color: #779087;
  font-size: 8px;
  font-style: normal;
}
.demo-table-row {
  border-top: 1px solid #e7efeb;
  background: rgba(255, 255, 255, 0.78);
}
.demo-table-row strong {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #315157;
  font-size: 9px;
}
.mini-avatar {
  display: grid;
  place-items: center;
  width: 18px;
  height: 18px;
  border-radius: 5px;
  background: #dbeee7;
  color: #2d8e8b;
  font-size: 6px;
}
.demo-table-row span,
.demo-table-row small {
  color: #84958f;
  font-size: 8px;
}
.demo-good {
  color: #18815e !important;
}
.demo-warning {
  color: #b87021 !important;
}
.demo-approval-layout {
  display: grid;
  grid-template-columns: 0.85fr 1.2fr;
  gap: 12px;
  margin-top: 25px;
}
.approval-list {
  display: grid;
  gap: 6px;
  align-content: start;
}
.approval-item {
  display: grid;
  grid-template-columns: 28px 1fr 10px;
  gap: 8px;
  align-items: center;
  padding: 10px;
  border: 1px solid #e0ebe6;
  border-radius: 8px;
  background: #fff;
  text-align: left;
}
.approval-item.selected {
  border-color: #58a997;
  background: #eaf6f1;
}
.approval-item span {
  display: grid;
  gap: 3px;
  min-width: 0;
}
.approval-item strong {
  color: #315157;
  font-size: 9px;
}
.approval-item small {
  overflow: hidden;
  color: #84958f;
  font-size: 7px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.approval-item i {
  color: #78918a;
  font-size: 16px;
}
.approval-detail {
  padding: 14px;
  border: 1px solid #e0ebe6;
  border-radius: 9px;
  background: #fff;
}
.approval-detail > small {
  color: #2d8e8b;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.1em;
}
.approval-detail h3 {
  margin: 10px 0 4px;
  color: #315157;
  font-size: 18px;
}
.approval-detail p {
  margin: 0;
  color: #526c65;
  font-size: 9px;
}
.approval-detail p span {
  color: #99a6a1;
}
.approval-facts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  margin: 16px 0;
}
.approval-facts b {
  display: grid;
  gap: 4px;
  padding: 9px;
  border-radius: 7px;
  background: #f1f7f4;
  color: #315157;
  font-size: 8px;
}
.approval-facts small {
  color: #8b9d95;
  font-size: 7px;
  font-weight: 500;
}
.approval-note {
  padding: 10px;
  border-left: 2px solid #d79a55;
  background: #faf6ef;
  color: #71817b;
  font-size: 9px;
  line-height: 1.5;
}
.approval-actions {
  display: flex;
  justify-content: end;
  gap: 6px;
  margin-top: 15px;
}
.approval-actions button {
  border: 1px solid #d9e6e0;
  border-radius: 6px;
  padding: 7px 9px;
  background: #fff;
  color: #6f817a;
  font-size: 8px;
}
.demo-map {
  position: relative;
  min-height: 384px;
  overflow: hidden;
  background: #dfece8;
}
.map-streets {
  position: absolute;
  inset: -20%;
  opacity: 0.7;
  transform: rotate(-8deg);
  background-image:
    linear-gradient(
      34deg,
      transparent 47%,
      #bfd6ce 48%,
      #bfd6ce 51%,
      transparent 52%
    ),
    linear-gradient(
      112deg,
      transparent 46%,
      #c7dbd4 47%,
      #c7dbd4 50%,
      transparent 51%
    );
  background-size:
    90px 70px,
    130px 100px;
}
.map-route {
  position: absolute;
  left: 16%;
  top: 23%;
  width: 66%;
  height: 46%;
  border: 5px solid #2d8e8b;
  border-left-color: transparent;
  border-bottom-color: #58c6b5;
  border-radius: 50%;
  transform: rotate(-12deg);
}
.map-pin {
  position: absolute;
  width: 18px;
  height: 18px;
  border: 4px solid #fff;
  border-radius: 50%;
  background: #d79a55;
  box-shadow: 0 4px 10px rgba(17, 44, 50, 0.2);
}
.map-pin-a {
  left: 13%;
  top: 22%;
}
.map-pin-b {
  right: 16%;
  bottom: 27%;
  background: #315247;
}
.map-label {
  position: absolute;
  padding: 5px 7px;
  border-radius: 5px;
  background: rgba(255, 255, 255, 0.8);
  color: #526c65;
  font-size: 8px;
}
.map-label-a {
  left: 10%;
  top: 15%;
}
.map-label-b {
  right: 10%;
  bottom: 21%;
}
.map-visit-card {
  position: absolute;
  right: 18px;
  bottom: 18px;
  display: grid;
  gap: 5px;
  width: 190px;
  padding: 13px;
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 12px 25px rgba(17, 44, 50, 0.1);
}
.map-visit-card strong {
  color: #315157;
  font-size: 13px;
}
.map-visit-card small {
  color: #82928c;
  font-size: 8px;
}
.map-visit-card > div {
  display: flex;
  justify-content: space-between;
  margin-top: 5px;
  color: #315157;
  font-size: 8px;
}
.live-pill {
  width: fit-content;
  color: #18815e;
  font-size: 8px;
  font-weight: 800;
}
.live-pill i {
  display: inline-block;
  width: 5px;
  height: 5px;
  margin-right: 4px;
  border-radius: 50%;
  background: #2dba83;
}
.report-tabs {
  display: flex;
  gap: 18px;
  margin: 22px 0 10px;
  border-bottom: 1px solid #e0ebe6;
}
.report-tabs > * {
  padding-bottom: 9px;
  color: #84958f;
  font-size: 9px;
}
.report-tabs b {
  border-bottom: 2px solid #2d8e8b;
  color: #315157;
}
.demo-report-chart {
  position: relative;
  height: 190px;
  padding: 10px 10px 5px 35px;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 46px,
    #e6efeb 47px
  );
}
.demo-report-chart svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}
.demo-report-chart path {
  fill: none;
  stroke: #2d8e8b;
  stroke-width: 5;
  stroke-linecap: round;
}
.demo-report-chart .chart-fill {
  fill: rgba(88, 198, 181, 0.17);
  stroke: none;
}
.chart-y {
  position: absolute;
  left: 0;
  top: 7px;
  bottom: 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.chart-y small {
  color: #9aa8a3;
  font-size: 7px;
}
.demo-report-foot {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 13px;
}
.demo-report-foot b {
  display: grid;
  gap: 4px;
  padding: 10px;
  border: 1px solid #e0ebe6;
  border-radius: 8px;
  background: #fff;
  color: #315157;
}
.demo-report-foot strong {
  font-size: 18px;
}
.demo-report-foot small {
  color: #84958f;
  font-size: 7px;
  font-weight: 500;
}
.tour-strip {
  display: grid;
  grid-template-columns: 1.4fr repeat(3, 1fr);
  gap: 12px;
  margin: 24px 0 100px;
  padding: 25px 0;
  border-top: 1px solid rgba(17, 44, 50, 0.1);
  border-bottom: 1px solid rgba(17, 44, 50, 0.1);
}
.tour-strip > div {
  display: grid;
  gap: 5px;
  padding: 4px 16px;
  border-left: 1px solid rgba(17, 44, 50, 0.1);
}
.tour-strip > div:first-child {
  border-left: 0;
  padding-left: 0;
}
.tour-strip small {
  color: #d79a55;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.tour-strip strong {
  color: #315157;
  font-size: 16px;
}
.tour-strip b {
  color: #2d8e8b;
  font-size: 20px;
}
.tour-strip span {
  color: #71817b;
  font-size: 11px;
}

/* Original login v3 */
.login-v3 {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  isolation: isolate;
  background: #f3f6ff;
  color: #182a45;
}
.login-v3::before {
  content: "";
  position: absolute;
  z-index: -2;
  inset: 0;
  background:
    radial-gradient(
      circle at 14% 20%,
      rgba(127, 160, 255, 0.18),
      transparent 30%
    ),
    radial-gradient(
      circle at 88% 75%,
      rgba(197, 153, 244, 0.2),
      transparent 31%
    ),
    linear-gradient(135deg, #f1f5ff, #fbfaff 55%, #f4effb);
}
.login-v3-noise {
  position: absolute;
  z-index: -1;
  inset: 0;
  opacity: 0.32;
  background-image:
    linear-gradient(rgba(79, 106, 180, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(79, 106, 180, 0.06) 1px, transparent 1px);
  background-size: 58px 58px;
  mask-image: linear-gradient(to bottom, #000, transparent 90%);
}
.login-v3-orbit {
  position: absolute;
  z-index: -1;
  border: 1px solid rgba(88, 112, 192, 0.13);
  border-radius: 50%;
}
.login-v3-orbit-one {
  width: 540px;
  height: 540px;
  top: -280px;
  right: -120px;
  box-shadow:
    0 0 0 35px rgba(88, 112, 192, 0.025),
    0 0 0 75px rgba(88, 112, 192, 0.018);
}
.login-v3-orbit-two {
  width: 360px;
  height: 360px;
  bottom: -235px;
  left: 30%;
  border-color: rgba(164, 112, 198, 0.15);
}
.login-v3-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: min(1240px, 88vw);
  margin: auto;
  padding: 28px 0 18px;
}
.login-v3-back {
  border: 0;
  background: transparent;
  color: #657898;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}
.login-v3-back span {
  margin-right: 8px;
  font-size: 18px;
}
.login-v3-time {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #53698c;
  font-size: 12px;
}
.login-v3-time strong {
  color: #243b61;
  font-size: 14px;
}
.login-v3-time small {
  padding-left: 8px;
  border-left: 1px solid #ccd6e8;
  color: #8795aa;
  font-size: 11px;
}
.login-v3-live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #57b995;
  box-shadow: 0 0 0 4px rgba(87, 185, 149, 0.14);
}
.login-v3-layout {
  display: grid;
  grid-template-columns: minmax(300px, 0.85fr) minmax(420px, 0.8fr);
  align-items: center;
  gap: clamp(55px, 9vw, 150px);
  width: min(1100px, 84vw);
  min-height: calc(100vh - 91px);
  margin: auto;
  padding: 30px 0 70px;
}
.login-v3-story {
  display: grid;
  align-content: center;
  gap: 70px;
}
.login-v3-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}
.login-v3-brand img {
  width: 43px;
  height: 43px;
  border-radius: 14px;
  object-fit: cover;
  box-shadow: 0 10px 22px rgba(77, 104, 178, 0.18);
}
.login-v3-brand div {
  display: grid;
  gap: 3px;
}
.login-v3-brand strong {
  color: #1c3155;
  font-size: 21px;
}
.login-v3-brand span {
  color: #8594a9;
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.login-v3-message {
  max-width: 440px;
}
.login-v3-message > span {
  color: #687ce1;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.18em;
}
.login-v3-message h1 {
  margin: 15px 0;
  color: #1b2e4f;
  font-size: clamp(42px, 5.5vw, 72px);
  line-height: 0.98;
  letter-spacing: -0.055em;
}
.login-v3-message p {
  max-width: 350px;
  margin: 0;
  color: #71819b;
  font-size: 16px;
  line-height: 1.7;
}
.login-v3-preview {
  width: min(100%, 430px);
  padding: 20px;
  border: 1px solid rgba(116, 139, 198, 0.18);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.47);
  box-shadow:
    0 22px 50px rgba(80, 101, 161, 0.1),
    inset 0 1px rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(18px);
}
.preview-top,
.preview-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7689a4;
  font-size: 10px;
}
.preview-top b {
  color: #3e9e79;
  font-size: 9px;
}
.preview-top b i {
  display: inline-block;
  width: 6px;
  height: 6px;
  margin-right: 4px;
  border-radius: 50%;
  background: #57b995;
}
.preview-value {
  display: grid;
  gap: 3px;
  margin: 23px 0 14px;
}
.preview-value strong {
  color: #243e70;
  font-size: 36px;
  letter-spacing: -0.04em;
}
.preview-value small {
  color: #8a99ad;
  font-size: 10px;
}
.preview-line {
  display: flex;
  align-items: end;
  gap: 5px;
  height: 58px;
  padding: 10px 0;
  border-top: 1px solid rgba(116, 139, 198, 0.1);
  border-bottom: 1px solid rgba(116, 139, 198, 0.1);
}
.preview-line span {
  flex: 1;
  min-height: 14px;
  border-radius: 4px 4px 1px 1px;
  background: linear-gradient(#8198f3, #b0b5eb);
}
.preview-line span:nth-child(2) {
  height: 60%;
}
.preview-line span:nth-child(3) {
  height: 75%;
}
.preview-line span:nth-child(4) {
  height: 48%;
}
.preview-line span:nth-child(5) {
  height: 86%;
}
.preview-line span:nth-child(6) {
  height: 69%;
}
.preview-line span:nth-child(7) {
  height: 94%;
}
.preview-footer {
  margin-top: 16px;
}
.preview-footer b {
  margin-right: 3px;
  color: #324e83;
  font-size: 13px;
}
.login-v3-panel {
  display: grid;
  place-items: center;
}
.login-v3-card {
  width: min(100%, 470px);
  padding: 42px;
  border: 1px solid rgba(111, 135, 196, 0.2);
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.7);
  box-shadow:
    0 32px 80px rgba(75, 96, 155, 0.16),
    0 0 0 8px rgba(255, 255, 255, 0.23);
  backdrop-filter: blur(25px);
}
.login-v3-card-head {
  display: flex;
  align-items: center;
  gap: 14px;
}
.login-v3-icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 15px;
  background: linear-gradient(145deg, #e5eafe, #f2e6fa);
}
.login-v3-icon img {
  width: 30px;
  height: 30px;
  border-radius: 10px;
}
.login-v3-card-head span {
  color: #7f8fa9;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}
.login-v3-card h2 {
  margin: 4px 0 0;
  color: #20375d;
  font-size: 29px;
  letter-spacing: -0.04em;
}
.login-v3-intro {
  margin: 25px 0 30px;
  color: #7586a0;
  font-size: 14px;
  line-height: 1.65;
}
.login-v3-field {
  display: grid;
  gap: 8px;
  margin-bottom: 23px;
}
.login-v3-field label,
.login-v3-label-row {
  color: #526b93;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.login-v3-input-row {
  display: flex;
  gap: 8px;
  padding: 5px;
  border: 1px solid #d4dff0;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.72);
}
.login-v3-input-row:focus-within {
  border-color: #8499ec;
  box-shadow: 0 0 0 4px rgba(119, 139, 235, 0.12);
}
.login-v3-input-row input {
  min-width: 0;
  flex: 1;
  border: 0;
  outline: 0;
  padding: 11px 10px;
  background: transparent;
  color: #20375d;
  font-size: 14px;
}
.login-v3-input-row input::placeholder {
  color: #a7b3c4;
}
.login-v3-input-row button {
  border: 0;
  border-radius: 8px;
  padding: 0 13px;
  background: #e8edff;
  color: #5d70d4;
  font-size: 10px;
  font-weight: 900;
  cursor: pointer;
}
.login-v3-input-row button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
.login-v3-label-row {
  display: flex;
  justify-content: space-between;
}
.login-v3-label-row small {
  color: #98a5b6;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0;
  text-transform: none;
}
.login-v3-otp-field {
  margin-bottom: 25px;
}
.login-v3-otp-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
}
.login-v3-otp-grid input {
  width: 100%;
  aspect-ratio: 1/1.08;
  border: 1px solid #d4dff0;
  border-radius: 11px;
  outline: 0;
  background: rgba(255, 255, 255, 0.7);
  color: #344f82;
  text-align: center;
  font-size: 20px;
  font-weight: 800;
}
.login-v3-otp-grid input:focus {
  border-color: #8499ec;
  box-shadow: 0 0 0 4px rgba(119, 139, 235, 0.12);
}
.login-v3-status {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: -4px 0 18px;
  padding: 10px 12px;
  border: 1px solid #c8e8d9;
  border-radius: 9px;
  background: #effaf4;
  color: #338266;
  font-size: 12px;
}
.login-v3-status span {
  display: grid;
  place-items: center;
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #66bd96;
  color: #fff;
  font-size: 10px;
}
.login-v3-status.is-error {
  border-color: #f0c8c4;
  background: #fff3f1;
  color: #b85e57;
}
.login-v3-status.is-error span {
  background: #df8178;
}
.login-v3-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  width: 100%;
  border: 0;
  border-radius: 12px;
  padding: 15px;
  background: linear-gradient(110deg, #5b70d8, #8178db);
  color: #fff;
  font-size: 13px;
  font-weight: 900;
  box-shadow: 0 13px 25px rgba(91, 112, 216, 0.25);
  cursor: pointer;
  transition:
    transform 0.2s,
    box-shadow 0.2s;
}
.login-v3-submit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 17px 30px rgba(91, 112, 216, 0.32);
}
.login-v3-submit:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
.login-v3-submit span {
  font-size: 18px;
}
.login-v3-spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: fxSpin 0.8s linear infinite;
}
.login-v3-meta {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 22px;
  color: #9aa8b9;
  font-size: 10px;
}
.login-v3-location {
  margin: 7px 0 0;
  color: #a1adbb;
  text-align: center;
  font-size: 10px;
}

@media (max-width: 760px) {
  .tour-nav-center {
    display: none;
  }
  .tour-nav-actions > a {
    display: none;
  }
  .tour-nav {
    width: calc(100% - 40px);
  }
  .tour-feature {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
    gap: 35px;
    padding: 60px 0 70px;
  }
  .tour-feature-visual {
    transform: none;
  }
  .tour-window {
    min-height: 330px;
  }
  .tour-strip {
    grid-template-columns: 1fr 1fr;
    margin-bottom: 70px;
  }
  .tour-strip > div:first-child {
    grid-column: 1/-1;
  }
  .tour-strip > div:nth-child(3) {
    border-left: 0;
  }
  .demo-people-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .demo-overview-lower {
    grid-template-columns: 1fr;
  }
  .demo-alerts {
    display: none;
  }
  .demo-approval-layout {
    grid-template-columns: 1fr;
  }
  .approval-detail {
    display: none;
  }
  .demo-table-row {
    grid-template-columns: 1.5fr 0.7fr 0.7fr;
  }
  .demo-table-row small,
  .demo-table-head i:last-child {
    display: none;
  }
  .login-v3-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: min(620px, 88vw);
    padding-top: 35px;
  }
  .login-v3-story {
    gap: 35px;
  }
  .login-v3-message h1 {
    font-size: 48px;
  }
  .login-v3-preview {
    display: none;
  }
  .login-v3-card {
    padding: 30px 24px;
  }
  .login-v3-panel {
    width: 100%;
  }
  .login-v3-time small {
    display: none;
  }
}
@media (max-width: 480px) {
  .tour-nav-enter {
    padding: 9px;
    font-size: 0;
  }
  .tour-nav-enter b {
    font-size: 16px;
  }
  .tour-hero-copy {
    margin-top: 45px;
  }
  .tour-chapters {
    grid-template-columns: repeat(3, 1fr);
  }
  .tour-chapters button:nth-child(n + 4) {
    display: none;
  }
  .tour-feature-copy h2 {
    font-size: 42px;
  }
  .tour-window {
    margin-inline: -5px;
  }
  .demo-work,
  .demo-window-content {
    padding: 15px;
  }
  .demo-stat-row {
    gap: 5px;
  }
  .demo-stat-row > div {
    padding: 9px;
  }
  .demo-stat-row strong {
    font-size: 17px;
  }
  .demo-heading strong {
    font-size: 15px;
  }
  .demo-filter-row b {
    display: none;
  }
  .demo-filter-row span {
    width: 100%;
  }
  .demo-attendance-kpis {
    gap: 4px;
  }
  .demo-attendance-kpis span {
    padding: 7px;
    font-size: 7px;
  }
  .demo-attendance-kpis b {
    font-size: 12px;
  }
  .demo-table-row,
  .demo-table-head {
    padding: 8px 6px;
    gap: 4px;
  }
  .demo-table-row strong {
    font-size: 8px;
  }
  .tour-strip {
    gap: 5px;
  }
  .tour-strip > div {
    padding-inline: 8px;
  }
  .login-v3-topbar {
    width: calc(100% - 40px);
  }
  .login-v3-layout {
    width: calc(100% - 40px);
  }
  .login-v3-message h1 {
    font-size: 42px;
  }
  .login-v3-otp-grid {
    gap: 5px;
  }
  .login-v3-otp-grid input {
    border-radius: 8px;
    font-size: 17px;
  }
}
